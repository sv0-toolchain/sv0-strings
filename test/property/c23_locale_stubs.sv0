/* SS-150 (SPEC C23-016, C23-017): strings_c23::strcoll / strxfrm / strerror.
 * Exit 0 = pass; nonzero = the number of the first failing check.
 *
 * strcoll/strxfrm unblocked by SS-U12 (2026-09-18): both are now real,
 * thin wrappers over strings_locale's fixed-POSIX-locale collation
 * (plain byte-wise ordering -- the same rule C's own strcoll follows
 * under the "C" locale). strerror stays a capability STUB: it needs
 * strings_unsafe_abi's FFI primitive (Future, BL-103/104), a completely
 * separate, not-yet-started prerequisite from SS-U12, to read the OS
 * error-message tables at all -- proven fail-closed across the FULL i32
 * range for errnum, including 0, a POSIX-shaped small positive, a large
 * positive, and the very edges of the type -- no branch on errnum exists
 * to misbehave at a boundary.
 */
use strings_types::HostCapability;
use strings_types::Ordering;
use strings_types::TransformWrite;
use strings_c23::strcoll;
use strings_c23::strxfrm;
use strings_c23::strxfrm_size;
use strings_c23::strerror;

fn is_unsupported(r: HostCapability) -> bool {
    return match r {
        HostCapability::Unsupported => { true },
    };
}

fn main() -> i32 {
    /* ================= strcoll (C23-016) ================= */
    let c1: Ordering = strcoll("abc", "abc");
    let eq1: bool = match c1 {
        Ordering::Less => { false },
        Ordering::Equal => { true },
        Ordering::Greater => { false },
    };
    if !eq1 { return 1; }

    let c2: Ordering = strcoll("abc", "abd");
    let lt2: bool = match c2 {
        Ordering::Less => { true },
        Ordering::Equal => { false },
        Ordering::Greater => { false },
    };
    if !lt2 { return 2; }

    let c3: Ordering = strcoll("zzz", "aaa");
    let gt3: bool = match c3 {
        Ordering::Less => { false },
        Ordering::Equal => { false },
        Ordering::Greater => { true },
    };
    if !gt3 { return 3; }

    let c4: Ordering = strcoll("", "");
    let eq4: bool = match c4 {
        Ordering::Less => { false },
        Ordering::Equal => { true },
        Ordering::Greater => { false },
    };
    if !eq4 { return 4; }

    /* ================= strxfrm (C23-016) ================= */
    let dst: [byte; 8] = [9, 9, 9, 9, 9, 9, 9, 9];
    let tw1: TransformWrite = strxfrm(&mut dst[..], "hello");
    let n1: usize = match tw1 {
        TransformWrite::Written(k) => { k },
        TransformWrite::DestinationTooSmall(_k) => { return 10; },
    };
    if n1 != 5 { return 11; }
    if dst[0] != 104 { return 12; }   /* 'h' */
    if dst[5] != 9 { return 13; }     /* untouched past the key */

    let empty_dst: [byte; 0] = [];
    let tw2: TransformWrite = strxfrm(&mut empty_dst[..], "x");
    let toosmall2: bool = match tw2 {
        TransformWrite::Written(_k) => { false },
        TransformWrite::DestinationTooSmall(k) => { k == 1 },
    };
    if !toosmall2 { return 14; }

    /* ================= strxfrm_size ================= */
    if strxfrm_size("hello") != 5 { return 15; }
    if strxfrm_size("") != 0 { return 16; }

    /* ================= strerror (C23-017) ================= */
    if is_unsupported(strerror(0)) != true { return 20; }
    if is_unsupported(strerror(1)) != true { return 21; }        /* EPERM-shaped */
    if is_unsupported(strerror(22)) != true { return 22; }       /* EINVAL-shaped */
    if is_unsupported(strerror(999999)) != true { return 23; }   /* far out of any real errno range */
    if is_unsupported(strerror(0 - 1)) != true { return 24; }    /* negative */
    if is_unsupported(strerror(2147483647)) != true { return 25; }         /* i32::MAX */
    if is_unsupported(strerror(0 - 2147483647 - 1)) != true { return 26; } /* i32::MIN */

    return 0;
}
