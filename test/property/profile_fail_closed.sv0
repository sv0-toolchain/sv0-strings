/* SS-173 (SPEC POSIX-014 / POSIX-015 / SEC-011): the fail-closed profile
 * gate.
 * Exit 0 = pass; nonzero = the number of the first failing check.
 *
 * A profile claim (e.g. "CX host-locale subprofile") may only be made when
 * every host service it needs is actually wired. While the versioned
 * host-capability ABI (toolchain slice SS-U12) and the FFI / host-call
 * primitive are both deferred, EVERY host-dependent entry point in this
 * library must return its typed "not available" value -- never a silent
 * success, never a downgrade to a bytewise/ASCII substitute. This fixture
 * calls every exported host-dependent entry point once and pins that.
 *
 * The POSIX-locale subprofile (`strcasecmp_l(_, _, Posix)` etc.) DOES run
 * -- it is a fixed ASCII fold with no host dependency -- and returns an
 * `Ordered(...)`; that arm is checked too, so "fail closed" cannot be
 * satisfied by failing everything.
 */
use strings_types::HostCapability;
use strings_types::HostMessage;
use strings_types::MessageWrite;
use strings_types::LocaleCompare;
use strings_c23::strcoll;
use strings_c23::strxfrm;
use strings_c23::strxfrm_size;
use strings_c23::strerror;
use strings_posix2024::strcoll_l;
use strings_posix2024::strxfrm_l;
use strings_posix2024::strxfrm_l_size;
use strings_posix2024::strerror_r;
use strings_posix2024::strerror_l;
use strings_posix2024::strsignal;
use strings_posix2024::strcasecmp_l;
use strings_posix2024::strncasecmp_l;
use strings_locale::LocaleId;
use strings_locale::LocaleOpen;
use strings_locale::open;

fn hc_unsupported(h: HostCapability) -> bool {
    return match h {
        HostCapability::Unsupported => { true },
    };
}

fn hm_unavailable(m: HostMessage) -> bool {
    return match m {
        HostMessage::Unavailable => { true },
        HostMessage::Text(_s) => { false },
    };
}

fn mw_unavailable(w: MessageWrite) -> bool {
    return match w {
        MessageWrite::Unavailable => { true },
        MessageWrite::Written(_n) => { false },
        MessageWrite::DestinationTooSmall(_n) => { false },
    };
}

fn lc_unsupported(c: LocaleCompare) -> bool {
    return match c {
        LocaleCompare::Unsupported => { true },
        LocaleCompare::Less => { false },
        LocaleCompare::Equal => { false },
        LocaleCompare::Greater => { false },
    };
}

fn lc_equal(c: LocaleCompare) -> bool {
    return match c {
        LocaleCompare::Equal => { true },
        LocaleCompare::Less => { false },
        LocaleCompare::Greater => { false },
        LocaleCompare::Unsupported => { false },
    };
}

fn main() -> i32 {
    /* ---- C23 host-dependent stubs (SS-150 / SS-151) ---- */
    if hc_unsupported(strcoll("abc", "abc")) != true { return 1; }
    let d: [byte; 4] = [1, 1, 1, 1];
    if hc_unsupported(strxfrm(&mut d[..], "abc")) != true { return 2; }
    if hc_unsupported(strxfrm_size("abc")) != true { return 3; }
    if hc_unsupported(strerror(0)) != true { return 4; }

    /* ---- POSIX `_l` collation / transform (SS-168) ---- */
    if hc_unsupported(strcoll_l("a", "b", LocaleId::Posix)) != true { return 10; }
    if hc_unsupported(strcoll_l("a", "b", LocaleId::HostNamed("en_US.UTF-8"))) != true { return 11; }
    let e: [byte; 4] = [2, 2, 2, 2];
    if hc_unsupported(strxfrm_l(&mut e[..], "a", LocaleId::Posix)) != true { return 12; }
    if hc_unsupported(strxfrm_l_size("a", LocaleId::HostNamed("de_DE.UTF-8"))) != true { return 13; }

    /* ---- POSIX owned message capability (SS-169) ---- */
    let m: [byte; 8] = [3, 3, 3, 3, 3, 3, 3, 3];
    if mw_unavailable(strerror_r(22, &mut m[..])) != true { return 20; }
    if hm_unavailable(strerror_l(22, LocaleId::Posix)) != true { return 21; }
    if hm_unavailable(strsignal(9)) != true { return 22; }

    /* ---- explicit-locale case fold (SS-173) ---- */
    /* HostNamed -> Unsupported, NEVER a silent ASCII downgrade (SPEC B.7) */
    if lc_unsupported(strcasecmp_l("i", "I", LocaleId::HostNamed("tr_TR.UTF-8"))) != true { return 30; }
    let x: [byte; 1] = [105];
    let y: [byte; 1] = [73];
    if lc_unsupported(strncasecmp_l(&x[..], &y[..], 1, LocaleId::HostNamed("tr_TR.UTF-8"))) != true { return 31; }
    /* Posix subprofile DOES run: fixed ASCII fold, 'i' == 'I' */
    if lc_equal(strcasecmp_l("i", "I", LocaleId::Posix)) != true { return 32; }
    if lc_equal(strncasecmp_l(&x[..], &y[..], 1, LocaleId::Posix)) != true { return 33; }

    /* ---- locale capability lifecycle (SS-167) ---- */
    if is_open_unavailable(open(LocaleId::Posix)) != true { return 40; }
    if is_open_unavailable(open(LocaleId::HostNamed("en_US.UTF-8"))) != true { return 41; }

    return 0;
}

fn is_open_unavailable(r: LocaleOpen) -> bool {
    return match r {
        LocaleOpen::Unavailable => { true },
        LocaleOpen::Unsupported => { false },
    };
}
