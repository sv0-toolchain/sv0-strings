/* SS-173 (SPEC POSIX-014 / POSIX-015 / SEC-011): the fail-closed profile
 * gate.
 * Exit 0 = pass; nonzero = the number of the first failing check.
 *
 * A profile claim (e.g. "CX host-locale subprofile") may only be made when
 * every host service it needs is actually wired. SS-U12 (2026-09-18)
 * landed the versioned host-capability ABI for `LocaleId::Posix` only
 * (Option B); the FFI / host-call primitive (`strings_unsafe_abi`) is
 * still deferred, and every `HostNamed` locale is still `Unsupported` by
 * design. This fixture calls every exported host-dependent entry point
 * once and pins the resulting fail-closed/succeeds split precisely: the
 * C23/`_l` locale-collation family and the locale lifecycle itself
 * (`open`) now really run for `Posix`; the host-message family
 * (`strerror_r`/`strerror_l`/`strsignal`, FFI-blocked) and every
 * `HostNamed` locale everywhere still fail closed -- never a silent
 * success where one isn't wired, never a downgrade to a bytewise/ASCII
 * substitute where one is.
 *
 * The POSIX-locale subprofile (`strcasecmp_l(_, _, Posix)` etc.) DOES run
 * -- it is a fixed ASCII fold with no host dependency -- and returns an
 * `Ordered(...)`; that arm is checked too, so "fail closed" cannot be
 * satisfied by failing everything.
 */
use strings_types::HostCapability;
use strings_types::HostMessage;
use strings_types::MessageWrite;
use strings_types::LocaleCompare;
use strings_types::Ordering;
use strings_types::TransformWrite;
use strings_types::LocaleTransformWrite;
use strings_types::LocaleTransformSize;
use strings_c23::strcoll;
use strings_c23::strxfrm;
use strings_c23::strxfrm_size;
use strings_c23::strerror;
use strings_posix2024::strcoll_l;
use strings_posix2024::strxfrm_l;
use strings_posix2024::strxfrm_l_size;
use strings_posix2024::strerror_r;
use strings_posix2024::strerror_l;
use strings_posix2024::strsignal;
use strings_posix2024::strcasecmp_l;
use strings_posix2024::strncasecmp_l;
use strings_locale::LocaleId;
use strings_locale::LocaleOpen;
use strings_locale::open;

fn hc_unsupported(h: HostCapability) -> bool {
    return match h {
        HostCapability::Unsupported => { true },
    };
}

fn hm_unavailable(m: HostMessage) -> bool {
    return match m {
        HostMessage::Unavailable => { true },
        HostMessage::Text(_s) => { false },
    };
}

fn mw_unavailable(w: MessageWrite) -> bool {
    return match w {
        MessageWrite::Unavailable => { true },
        MessageWrite::Written(_n) => { false },
        MessageWrite::DestinationTooSmall(_n) => { false },
    };
}

fn lc_unsupported(c: LocaleCompare) -> bool {
    return match c {
        LocaleCompare::Unsupported => { true },
        LocaleCompare::Less => { false },
        LocaleCompare::Equal => { false },
        LocaleCompare::Greater => { false },
    };
}

fn lc_equal(c: LocaleCompare) -> bool {
    return match c {
        LocaleCompare::Equal => { true },
        LocaleCompare::Less => { false },
        LocaleCompare::Greater => { false },
        LocaleCompare::Unsupported => { false },
    };
}

fn main() -> i32 {
    /* ---- C23 locale collation, real now for the fixed POSIX/C locale
       (SS-U12); strerror is still FFI-blocked (SS-150 / SS-151) ---- */
    let cc: Ordering = strcoll("abc", "abc");
    let cceq: bool = match cc {
        Ordering::Equal => { true },
        Ordering::Less => { false },
        Ordering::Greater => { false },
    };
    if !cceq { return 1; }
    let d: [byte; 4] = [1, 1, 1, 1];
    let dtw: TransformWrite = strxfrm(&mut d[..], "abc");
    let dwritten: bool = match dtw {
        TransformWrite::Written(k) => { k == 3 },
        TransformWrite::DestinationTooSmall(_k) => { false },
    };
    if !dwritten { return 2; }
    if strxfrm_size("abc") != 3 { return 3; }
    if hc_unsupported(strerror(0)) != true { return 4; }

    /* ---- POSIX `_l` collation / transform: Posix real, HostNamed still
       Unsupported (SS-168) ---- */
    let lc10: LocaleCompare = strcoll_l("a", "b", LocaleId::Posix);
    let lc10lt: bool = match lc10 {
        LocaleCompare::Less => { true },
        LocaleCompare::Equal => { false },
        LocaleCompare::Greater => { false },
        LocaleCompare::Unsupported => { false },
    };
    if !lc10lt { return 10; }
    if lc_unsupported(strcoll_l("a", "b", LocaleId::HostNamed("en_US.UTF-8"))) != true { return 11; }
    let e: [byte; 4] = [2, 2, 2, 2];
    let etw: LocaleTransformWrite = strxfrm_l(&mut e[..], "a", LocaleId::Posix);
    let ewritten: bool = match etw {
        LocaleTransformWrite::Written(k) => { k == 1 },
        LocaleTransformWrite::DestinationTooSmall(_k) => { false },
        LocaleTransformWrite::Unsupported => { false },
    };
    if !ewritten { return 12; }
    let sz13: LocaleTransformSize = strxfrm_l_size("a", LocaleId::HostNamed("de_DE.UTF-8"));
    let sz13unsup: bool = match sz13 {
        LocaleTransformSize::Size(_k) => { false },
        LocaleTransformSize::Unsupported => { true },
    };
    if !sz13unsup { return 13; }

    /* ---- POSIX owned message capability (SS-169) ---- */
    let m: [byte; 8] = [3, 3, 3, 3, 3, 3, 3, 3];
    if mw_unavailable(strerror_r(22, &mut m[..])) != true { return 20; }
    if hm_unavailable(strerror_l(22, LocaleId::Posix)) != true { return 21; }
    if hm_unavailable(strsignal(9)) != true { return 22; }

    /* ---- explicit-locale case fold (SS-173) ---- */
    /* HostNamed -> Unsupported, NEVER a silent ASCII downgrade (SPEC B.7) */
    if lc_unsupported(strcasecmp_l("i", "I", LocaleId::HostNamed("tr_TR.UTF-8"))) != true { return 30; }
    let x: [byte; 1] = [105];
    let y: [byte; 1] = [73];
    if lc_unsupported(strncasecmp_l(&x[..], &y[..], 1, LocaleId::HostNamed("tr_TR.UTF-8"))) != true { return 31; }
    /* Posix subprofile DOES run: fixed ASCII fold, 'i' == 'I' */
    if lc_equal(strcasecmp_l("i", "I", LocaleId::Posix)) != true { return 32; }
    if lc_equal(strncasecmp_l(&x[..], &y[..], 1, LocaleId::Posix)) != true { return 33; }

    /* ---- locale capability lifecycle: Posix really opens now (SS-U12);
       HostNamed stays Unsupported (SS-167) ---- */
    if is_open_opened(open(LocaleId::Posix)) != true { return 40; }
    if is_open_unsupported(open(LocaleId::HostNamed("en_US.UTF-8"))) != true { return 41; }

    return 0;
}

fn is_open_opened(r: LocaleOpen) -> bool {
    return match r {
        LocaleOpen::Opened(_cap) => { true },
        LocaleOpen::Unsupported => { false },
        LocaleOpen::Unavailable => { false },
    };
}

fn is_open_unsupported(r: LocaleOpen) -> bool {
    return match r {
        LocaleOpen::Opened(_cap) => { false },
        LocaleOpen::Unsupported => { true },
        LocaleOpen::Unavailable => { false },
    };
}
