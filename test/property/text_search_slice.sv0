/* SS-124 (SPEC TEXT-007..011): strings_text::find_byte / find / rfind /
 * starts_with / ends_with / slice_bytes.
 * Exit 0 = pass; nonzero = the number of the first failing check.
 *
 * "Aé水" = 41 C3 A9 E6 B0 B4 (6 bytes); scalar boundaries at 0, 1, 3, 6;
 * bytes 2, 4, 5 are mid-scalar. Byte values are decimal; the hex is in the
 * comment. Expected offsets are hand-derived (SPEC Appendix C.4 / §11.3 /
 * AC-005).
 */
use strings_types::Option;
use strings_types::SliceResult;
use strings_text::find_byte;
use strings_text::find;
use strings_text::rfind;
use strings_text::starts_with;
use strings_text::ends_with;
use strings_text::slice_bytes;
use strings_text::equal;
use strings_text::len_bytes;

fn opt_i(o: Option<usize>) -> i32 {
    return match o {
        Option::Some(k) => { k as i32 },
        Option::None => { 0 - 1 },
    };
}

fn slice_ok(value: string, s: usize, e: usize, want: string) -> bool {
    return match slice_bytes(value, s, e) {
        SliceResult::Slice(r) => {
            if equal(r, want) { len_bytes(r) == len_bytes(want) } else { false }
        },
        SliceResult::NotScalarBoundary(_o) => { false },
    };
}

fn slice_bad(value: string, s: usize, e: usize, want_off: i32) -> bool {
    return match slice_bytes(value, s, e) {
        SliceResult::Slice(_r) => { false },
        SliceResult::NotScalarBoundary(o) => { o as i32 == want_off },
    };
}

fn main() -> i32 {
    let g: string = "A\xc3\xa9\xe6\xb0\xb4";   /* "Aé水" */

    /* ---- find_byte (TEXT-007): raw byte search, may be mid-scalar ---- */
    if opt_i(find_byte(g, 65)) != 0 { return 1; }       /* 'A' */
    if opt_i(find_byte(g, 195)) != 1 { return 2; }      /* C3 lead */
    if opt_i(find_byte(g, 169)) != 2 { return 3; }      /* A9 continuation -> index 2, NOT a boundary */
    if opt_i(find_byte(g, 180)) != 5 { return 4; }      /* B4 continuation */
    if opt_i(find_byte(g, 122)) != 0 - 1 { return 5; }  /* 'z' absent */
    if opt_i(find_byte("", 65)) != 0 - 1 { return 6; }

    /* ---- find / rfind (TEXT-008, TEXT-009) ---- */
    if opt_i(find("banana", "an")) != 1 { return 10; }
    if opt_i(rfind("banana", "an")) != 3 { return 11; }
    if opt_i(find("banana", "x")) != 0 - 1 { return 12; }
    if opt_i(find("abc", "")) != 0 { return 13; }             /* empty -> Some(0) */
    if opt_i(rfind("abc", "")) != 3 { return 14; }            /* empty -> Some(len) */
    if opt_i(find("abc", "abcd")) != 0 - 1 { return 15; }     /* needle longer */
    if opt_i(find("aaa", "aa")) != 0 { return 16; }
    if opt_i(rfind("aaa", "aa")) != 1 { return 17; }
    if opt_i(find(g, "\xc3\xa9")) != 1 { return 18; }         /* "é" at boundary 1 */
    if opt_i(rfind(g, "\xc3\xa9")) != 1 { return 19; }
    if opt_i(find(g, "\xe6\xb0\xb4")) != 3 { return 20; }     /* "水" at boundary 3 */
    if opt_i(find("\xe6\xb0\xb4\xe6\xb0\xb4", "\xe6\xb0\xb4")) != 0 { return 21; }
    if opt_i(rfind("\xe6\xb0\xb4\xe6\xb0\xb4", "\xe6\xb0\xb4")) != 3 { return 22; }
    if opt_i(find(g, g)) != 0 { return 23; }
    if opt_i(find("a\0b\0a", "\0b")) != 1 { return 24; }      /* embedded NUL in needle */
    if opt_i(rfind("a\0a\0a", "a")) != 4 { return 25; }

    /* ---- starts_with / ends_with (TEXT-009 empty rule) ---- */
    if starts_with("hello", "he") != true { return 30; }
    if starts_with("hello", "") != true { return 31; }
    if starts_with("hello", "hello") != true { return 32; }
    if starts_with("hi", "hix") != false { return 33; }
    if starts_with("hello", "el") != false { return 34; }
    if ends_with("hello", "lo") != true { return 35; }
    if ends_with("hello", "") != true { return 36; }
    if ends_with("hi", "xhi") != false { return 37; }
    if ends_with("hello", "ell") != false { return 38; }
    if starts_with(g, "A\xc3\xa9") != true { return 39; }
    if ends_with(g, "\xe6\xb0\xb4") != true { return 40; }
    if starts_with("a\0b", "a\0") != true { return 41; }
    if ends_with("a\0b", "\0b") != true { return 42; }

    /* ---- slice_bytes ok (TEXT-010, TEXT-011) ---- */
    if slice_ok(g, 1, 3, "\xc3\xa9") != true { return 50; }        /* "é" (AC of §11.3) */
    if slice_ok(g, 0, 1, "A") != true { return 51; }
    if slice_ok(g, 3, 6, "\xe6\xb0\xb4") != true { return 52; }    /* "水" */
    if slice_ok(g, 0, 6, "A\xc3\xa9\xe6\xb0\xb4") != true { return 53; }
    if slice_ok(g, 3, 3, "") != true { return 54; }               /* empty, both boundary */
    if slice_ok(g, 0, 0, "") != true { return 55; }
    if slice_ok(g, 6, 6, "") != true { return 56; }
    if slice_ok(g, 1, 6, "\xc3\xa9\xe6\xb0\xb4") != true { return 57; }
    if slice_ok("abcdef", 2, 4, "cd") != true { return 58; }
    if slice_ok("a\0b\0c", 1, 4, "\0b\0") != true { return 59; }

    /* ---- slice_bytes rejects non-boundary / out-of-range, no OOB read ---- */
    if slice_bad(g, 2, 3, 2) != true { return 60; }   /* start mid-scalar (AC-005) */
    if slice_bad(g, 1, 2, 2) != true { return 61; }   /* end mid-scalar */
    if slice_bad(g, 4, 5, 4) != true { return 62; }   /* start mid-scalar (in 水) */
    if slice_bad(g, 0, 7, 7) != true { return 63; }   /* end past len */
    if slice_bad(g, 7, 7, 7) != true { return 64; }   /* start past len */
    if slice_bad(g, 3, 1, 3) != true { return 65; }   /* start > end */
    if slice_bad(g, 5, 5, 5) != true { return 66; }   /* start==end but mid-scalar */

    /* ---- round-trip: slice equals the byte view, stays valid UTF-8 ---- */
    if slice_ok(g, 0, 3, "A\xc3\xa9") != true { return 70; }
    /* [0,1) ++ [1,3) ++ [3,6) reconstructs g */
    let p0: string = "A";
    let p1: string = "\xc3\xa9";
    let p2: string = "\xe6\xb0\xb4";
    if slice_ok(g, 0, 1, p0) != true { return 71; }
    if slice_ok(g, 1, 3, p1) != true { return 72; }
    if slice_ok(g, 3, 6, p2) != true { return 73; }

    return 0;
}
