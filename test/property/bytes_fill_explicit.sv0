/* SS-U11 unblock (SPEC BYTE-010): strings_bytes::fill_explicit. Exit 0 =
 * pass; nonzero = first failing check.
 *
 * Observable behavior is identical to `fill` (bytes_fill.sv0) -- the only
 * difference BYTE-010 adds is a backend-enforced non-elision guarantee,
 * which this program cannot itself observe (that is a source-inspection
 * property of the emitted C / bytecode, not a runtime one). This fixture
 * proves fill_explicit is at least as correct as fill: same guard-byte
 * discipline, same boundary cases.
 */
use strings_bytes::fill_explicit;

fn main() -> i32 {
    /* guard bytes at [0] and [5]; fill a[1..5] */
    let a: [byte; 6] = [11, 22, 33, 44, 55, 66];
    let m: &mut [byte] = &mut a[1..5];
    fill_explicit(m, 7);
    if a[0] != 11 { return 10; }     /* leading guard */
    if a[5] != 66 { return 11; }     /* trailing guard */
    if a[1] != 7 { return 12; }
    if a[2] != 7 { return 13; }
    if a[3] != 7 { return 14; }
    if a[4] != 7 { return 15; }

    /* fill with 0x00 -- the actual scrub-a-secret case fill_explicit exists
       for: the buffer is dead right after, so ONLY the non-elision
       guarantee (not tested here) keeps this from being optimized away. */
    let b: [byte; 3] = [9, 9, 9];
    fill_explicit(&mut b[..], 0);
    if b[0] != 0 { return 20; }
    if b[1] != 0 { return 21; }
    if b[2] != 0 { return 22; }

    /* fill with 0xFF */
    let c: [byte; 2] = [1, 2];
    fill_explicit(&mut c[..], 255);
    if c[0] != 255 { return 30; }
    if c[1] != 255 { return 31; }

    /* fill an empty view: no-op, no fault */
    let d: [byte; 0] = [];
    fill_explicit(&mut d[..], 5);

    /* fill a whole array */
    let e: [byte; 4] = [1, 2, 3, 4];
    fill_explicit(&mut e[..], 42);
    if e[0] != 42 { return 40; }
    if e[1] != 42 { return 41; }
    if e[2] != 42 { return 42; }
    if e[3] != 42 { return 43; }

    /* single-element view with a guard on each side */
    let g: [byte; 3] = [1, 2, 3];
    let mg: &mut [byte] = &mut g[1..2];
    fill_explicit(mg, 99);
    if g[0] != 1 { return 50; }      /* guard */
    if g[1] != 99 { return 51; }
    if g[2] != 3 { return 52; }      /* guard */

    return 0;
}
