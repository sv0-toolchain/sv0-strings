/* SS-148 (SPEC C23-014): strings_c23::memset.
 * Exit 0 = pass; nonzero = the number of the first failing check.
 *
 * `memset` is a one-line map to `strings_bytes::fill` -- no new algorithm
 * (SPEC ARCH-003). `memset_explicit` stays Blocked (BYTE-010) and is not
 * exported from this module (pinned by
 * `test/compile_fail/c23_memset_explicit_blocked.sv0`). Expected results
 * are hand-derived C23 facts (differential vs the C oracle is
 * `test/differential/c23_memset_oracle.py`, reusing the `memset` op the
 * oracle already wired for SS-141). Byte values decimal.
 */
use strings_c23::memset;

fn main() -> i32 {
    let d1: [byte; 6] = [9, 9, 9, 9, 9, 9];
    memset(&mut d1[..], 90);
    if d1[0] != 90 { return 1; }
    if d1[5] != 90 { return 2; }

    /* zero-fill (the common scrub-looking call -- still plain memset, no
       non-elision guarantee; that's exactly why memset_explicit exists and
       stays Blocked here) */
    let d2: [byte; 4] = [1, 2, 3, 4];
    memset(&mut d2[..], 0);
    if d2[0] != 0 { return 3; }
    if d2[3] != 0 { return 4; }

    /* empty slice -> no-op, no panic */
    let d3: [byte; 0] = [];
    memset(&mut d3[..], 7);

    /* high byte value (unsigned, C23-018/022) */
    let d4: [byte; 3] = [0, 0, 0];
    memset(&mut d4[..], 255);
    if d4[1] != 255 { return 5; }

    return 0;
}
