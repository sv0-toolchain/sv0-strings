/* SS-009 RED fixture -- SPEC UP-002 / UP-003 / AC-001, gap SPEC §4.4 #1/#3.
 *
 * `string_substr("Xa\0bY", 1, 3)` MUST yield the 3-byte value `a 00 b`, and
 * `string_len` of that result MUST be 3. The byte copy may be correct (it
 * takes an explicit length), but `string_len` on the result still lowers to
 * `strlen` and reports 1.
 *
 * 97='a' 98='b'. 0 = SPEC-correct. Expected: FAILS on C today at the
 * `string_len(r)` check.
 */
fn main() -> i32 {
    let r: string = string_substr("Xa\0bY", 1, 3);
    if string_char_at(r, 0) != 97 {
        return 1;
    }
    if string_char_at(r, 1) != 0 {
        return 2;
    }
    if string_char_at(r, 2) != 98 {
        return 3;
    }
    if string_len(r) != 3 {
        return 4;
    }
    return 0;
}
