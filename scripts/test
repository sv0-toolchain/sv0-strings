#!/usr/bin/env bash
# sv0-strings staging test runner (slice SS-010, SPEC ARCH-011 / UP-010).
#
# Current sv0 project discovery recursively compiles every .sv0 file, so each
# test run stages `lib/` plus EXACTLY ONE selected `main.sv0` in a fresh temp
# directory, then builds + runs it on the C backend and (optionally) the
# canonical native-VM path. Exit code is the oracle (SPEC §21.1: 0 = pass).
# Expected non-zero exits for RED fixtures live in `test/expectations.tsv`.
#
# Usage:
#   scripts/test [--backend=c|vm|both] [--contract-mode=runtime|verified|disabled]
#                [--case <name-or-path>]... [--dir <dir>] [--record <file>]
#                [--list] [--self-test] [--keep] [--fast] [-q]
#
# The C leg uses `./scripts/sv0 native-compile --project --contract-mode=<m>`
# (SPEC UP-022 canonical path; honours the mode, verifies the runtime/entry
# ABI manifests). The VM leg uses `./scripts/sv0 vm-native-compile --project`
# + `vm-run` -- the NATIVE emitter, never frozen SML `vm-project-compile`
# (SPEC UP-027 / ARCH-015). VM project mode has no contract-mode selector
# (SPEC OQ-012); a non-runtime request is reported unsupported, not faked.
# --fast bypasses the driver (raw megatu emitter + cc; contracts=runtime).
# --record appends `case<TAB>backend<TAB>emitter<TAB>mode<TAB>want<TAB>got`.
#
# --case may be a bare stem (searched under test/cases, test/property,
# test/fixtures/regressions) or a repo-relative path. With no --case and no
# --dir, every .sv0 under test/cases is run.
#
# Toolchain: $SV0_TOOLCHAIN_ROOT, else the parent dir when sv0-strings is a
# submodule, else ../sv0-toolchain. Needs build/sv0-megatu-compiler-native
# (C) and, for the VM leg, build/sv0-megatu-vm-native + SML/NJ + sv0vm/.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -n "${SV0_TOOLCHAIN_ROOT:-}" ]]; then
  TC="$SV0_TOOLCHAIN_ROOT"
elif [[ -d "$HERE/../sv0c" && -x "$HERE/../build/sv0-megatu-compiler-native" ]]; then
  TC="$HERE/.."
elif [[ -d "$HERE/../sv0-toolchain" ]]; then
  TC="$HERE/../sv0-toolchain"
else
  echo "sv0-strings/scripts/test: cannot locate sv0-toolchain (set SV0_TOOLCHAIN_ROOT)" >&2
  exit 2
fi
TC="$(cd "$TC" && pwd)"
NC="$TC/build/sv0-megatu-compiler-native"
VC="$TC/build/sv0-megatu-vm-native"
RT="$TC/sv0c/runtime"
RUN_SV0B="$TC/sv0vm/scripts/run_sv0b.sml"
EXPECT="$HERE/test/expectations.tsv"

BACKEND=c
CONTRACT_MODE=runtime
QUIET=0
KEEP=0
SELFTEST=0
LIST=0
FAST=0
RECORD=""
declare -a CASES=()
DIR=""

for a in "$@"; do
  case "$a" in
    --backend=*)       BACKEND="${a#*=}" ;;
    --contract-mode=*) CONTRACT_MODE="${a#*=}" ;;
    --case=*)          CASES+=("${a#*=}") ;;
    --case)            echo "use --case=<name>" >&2; exit 2 ;;
    --dir=*)           DIR="${a#*=}" ;;
    --record=*)        RECORD="${a#*=}" ;;
    --list)            LIST=1 ;;
    --self-test)       SELFTEST=1 ;;
    --keep)            KEEP=1 ;;
    --fast)            FAST=1 ;;
    -q|--quiet)        QUIET=1 ;;
    -h|--help)         sed -n '2,24p' "$0"; exit 0 ;;
    *) echo "sv0-strings/scripts/test: unknown arg: $a" >&2; exit 2 ;;
  esac
done
case "$CONTRACT_MODE" in runtime|verified|disabled) ;; *)
  echo "scripts/test: --contract-mode must be runtime|verified|disabled" >&2; exit 2 ;;
esac

SV0="$TC/scripts/sv0"           # canonical workspace driver (SPEC UP-022/UP-027)
USE_WRAPPER=1
[[ -x "$SV0" && "$FAST" -eq 0 ]] || USE_WRAPPER=0

log() { [[ "$QUIET" -eq 1 ]] || echo "$@"; }
rec() { [[ -n "$RECORD" ]] && printf '%s\n' "$*" >> "$RECORD"; return 0; }

resolve_case() {
  # echo repo-relative path for a stem or path; empty if not found
  local c="$1"
  if [[ -f "$HERE/$c" ]]; then echo "$c"; return; fi
  local d
  for d in test/cases test/property test/fixtures/regressions test/compile_fail; do
    if [[ -f "$HERE/$d/$c" ]]; then echo "$d/$c"; return; fi
    if [[ -f "$HERE/$d/$c.sv0" ]]; then echo "$d/$c.sv0"; return; fi
  done
  echo ""
}

expected_exit() {
  # $1 = repo-relative path, $2 = c|vm  -> echoes expected code or "SKIP"
  local p="$1" col="$2" line
  line="$(awk -F'\t' -v p="$p" '$1==p {print; exit}' "$EXPECT" 2>/dev/null)"
  if [[ -z "$line" ]]; then echo 0; return; fi
  if [[ "$col" == "c" ]]; then echo "$line" | cut -f2; else echo "$line" | cut -f3; fi
}

stage() {
  # $1 = main .sv0 (repo-relative)  -> echoes staged dir
  local main="$1" s
  s="$(mktemp -d)"
  mkdir -p "$s/lib"
  cp "$HERE"/lib/*.sv0 "$s/lib/"
  cp "$HERE/$main" "$s/main.sv0"
  echo "$s"
}

# build_run_c echoes  <exit-or-status>|<emitter>|<mode>
build_run_c() {
  local s="$1" bin="$s/out_c"
  if [[ "$USE_WRAPPER" -eq 1 ]]; then
    # SPEC UP-022 canonical path: driver honours --contract-mode + ABI manifests.
    if "$SV0" native-compile --project "$s" --contract-mode="$CONTRACT_MODE" -o "$bin" \
         > "$s/build.log" 2>&1; then
      local m; m="$(grep -oE 'contracts=[a-z]+' "$s/build.log" | head -1 | cut -d= -f2)"
      "$bin"; echo "$?|native-compile|${m:-$CONTRACT_MODE}"; return
    fi
    echo "BUILD_FAIL|native-compile|$CONTRACT_MODE"; return
  fi
  # --fast / no driver: raw native emitter + cc; contracts always runtime.
  local c="$s/out.c"
  "$NC" --project "$s" > "$c" 2> "$s/emit.err" || { echo "EMIT_FAIL|megatu-raw|runtime"; return; }
  [[ -s "$c" ]] || { echo "EMIT_EMPTY|megatu-raw|runtime"; return; }
  cc -std=c99 -O0 -w -I "$RT" "$c" "$RT/sv0_runtime.c" -o "$bin" 2> "$s/cc.err" \
    || { echo "CC_FAIL|megatu-raw|runtime"; return; }
  "$bin"; echo "$?|megatu-raw|runtime"
}

# build_run_vm echoes  <exit-or-status>|<emitter>|<mode>
# VM project mode has no contract-mode selector (SPEC OQ-012 / UP-028;
# docs/BUGS.md #6). Effective mode is always runtime; a non-runtime request
# is reported unsupported, never silently honoured.
build_run_vm() {
  local s="$1" b out code
  if [[ "$CONTRACT_MODE" != "runtime" ]]; then echo "MODE_UNSUPPORTED|-|$CONTRACT_MODE"; return; fi
  b="$s/out.sv0b"
  if [[ "$USE_WRAPPER" -eq 1 ]]; then
    "$SV0" vm-native-compile --project "$s" "$b" > "$s/vbuild.log" 2>&1 \
      || { echo "EMIT_FAIL|vm-native-compile|runtime"; return; }
    [[ -s "$b" ]] || { echo "EMIT_EMPTY|vm-native-compile|runtime"; return; }
    out="$("$SV0" vm-run "$b" 2>&1)"
    if [[ "$out" == *"arithmetic on non-int"* ]]; then echo "VM_NONINT|vm-native-compile|runtime"; return; fi
    code="$(echo "$out" | grep -oE 'vm_exit:-?[0-9]+' | head -1 | cut -d: -f2)"
    [[ -n "$code" ]] && echo "$(( code & 255 ))|vm-native-compile|runtime" \
      || echo "NO_EXIT|vm-native-compile|runtime"
    return
  fi
  [[ -x "$VC" ]] || { echo "NO_VM_EMITTER|megatu-vm-raw|runtime"; return; }
  SV0_DRV_REQUEST="--project $s" "$VC" > "$b" 2> "$s/vemit.err" \
    || { echo "EMIT_FAIL|megatu-vm-raw|runtime"; return; }
  [[ -s "$b" ]] || { echo "EMIT_EMPTY|megatu-vm-raw|runtime"; return; }
  out="$(cd "$TC/sv0vm" && SV0B="$b" sml < "$RUN_SV0B" 2>&1)"
  if [[ "$out" == *"arithmetic on non-int"* ]]; then echo "VM_NONINT|megatu-vm-raw|runtime"; return; fi
  code="$(echo "$out" | grep -oE 'vm_exit:-?[0-9]+' | head -1 | cut -d: -f2)"
  [[ -n "$code" ]] && echo "$(( code & 255 ))|megatu-vm-raw|runtime" || echo "NO_EXIT|megatu-vm-raw|runtime"
}

run_compile_fail() {
  # $1 = repo-relative path under test/compile_fail/. The C emit MUST fail
  # and stderr MUST contain the file's `EXPECT-FAIL: <needle>` marker.
  local main="$1" s needle
  needle="$(sed -n '1,15p' "$HERE/$main" | grep -oE 'EXPECT-FAIL:[[:space:]]*[^*]+' | head -1 | sed 's/EXPECT-FAIL:[[:space:]]*//' | sed 's/[[:space:]]*$//')"
  if [[ -z "$needle" ]]; then
    log "  FAIL  $main   no 'EXPECT-FAIL: <needle>' marker"; RC=1; return
  fi
  s="$(mktemp -d)"; mkdir -p "$s/lib"
  cp "$HERE"/lib/*.sv0 "$s/lib/"
  cp "$HERE/$main" "$s/main.sv0"
  local rc
  "$NC" --project "$s" > "$s/o.c" 2> "$s/e"; rc=$?
  if [[ "$rc" -eq 0 ]]; then
    [[ "$KEEP" -eq 1 ]] || rm -rf "$s"
    log "  FAIL  $main   emit SUCCEEDED (expected failure w/ '$needle')"; RC=1; return
  fi
  if grep -qF "$needle" "$s/e"; then
    [[ "$KEEP" -eq 1 ]] || rm -rf "$s"
    log "  ok    $main   rejected: '$needle'"; RC=0; return
  fi
  log "  FAIL  $main   failed but needle '$needle' not in diagnostic:"
  [[ "$QUIET" -eq 1 ]] || sed 's/^/        /' "$s/e" | head -4
  [[ "$KEEP" -eq 1 ]] || rm -rf "$s"
  RC=1
}

run_one() {
  # $1 = repo-relative main; sets RC (0 ok / 1 fail); prints a line
  local main="$1" s cexp vexp cgot vgot ok=1 detail=""
  case "$main" in
    test/compile_fail/*) run_compile_fail "$main"; return ;;
  esac
  s="$(stage "$main")"
  local raw em md
  if [[ "$BACKEND" == "c" || "$BACKEND" == "both" ]]; then
    cexp="$(expected_exit "$main" c)"
    raw="$(build_run_c "$s")"; cgot="${raw%%|*}"; em="${raw#*|}"; md="${em#*|}"; em="${em%%|*}"
    if [[ "$cexp" == "SKIP" ]]; then detail+=" C=skip"
    elif [[ "$cgot" == "$cexp" ]]; then detail+=" C=$cgot"
    else ok=0; detail+=" C=$cgot(want $cexp)"; fi
    rec "$main	c	$em	$md	$cexp	$cgot"
  fi
  if [[ "$BACKEND" == "vm" || "$BACKEND" == "both" ]]; then
    vexp="$(expected_exit "$main" vm)"
    raw="$(build_run_vm "$s")"; vgot="${raw%%|*}"; em="${raw#*|}"; md="${em#*|}"; em="${em%%|*}"
    if [[ "$vexp" == "SKIP" || "$vgot" == "MODE_UNSUPPORTED" ]]; then detail+=" VM=skip"
    elif [[ "$vgot" == "$vexp" ]]; then detail+=" VM=$vgot"
    else ok=0; detail+=" VM=$vgot(want $vexp)"; fi
    rec "$main	vm	$em	$md	$vexp	$vgot"
  fi
  [[ "$KEEP" -eq 1 ]] && detail+="  [$s]" || rm -rf "$s"
  if [[ "$ok" -eq 1 ]]; then log "  ok    $main   $detail"; RC=0
  else                       log "  FAIL  $main   $detail"; RC=1; fi
}

# ---- duplicate-main negative probe (ARCH-011, UP-026) ----
# Two files each defining `fn main` MUST be a stable diagnostic. Today the
# native compiler silently keeps the last one by filename order and emits a
# working binary (docs/BUGS.md #4, slice SS-U09). Reported as xfail so
# --self-test stays green while tracking the gap; flip to a hard assertion
# when SS-U09 lands.
dup_main_probe() {
  local s; s="$(mktemp -d)"; mkdir -p "$s/lib"
  cp "$HERE"/lib/*.sv0 "$s/lib/"
  printf 'fn main() -> i32 { return 0; }\n' > "$s/main.sv0"
  printf 'fn main() -> i32 { return 1; }\n' > "$s/main_two.sv0"
  if "$NC" --project "$s" > "$s/o.c" 2> "$s/e"; then
    rm -rf "$s"
    log "  xfail <dup-main probe>   two 'main' entries accepted silently (SS-U09 / BUGS.md #4)"
    return 0
  fi
  rm -rf "$s"; log "  ok    <dup-main probe>   build rejected as expected"; return 0
}

[[ -x "$NC" ]] || { echo "scripts/test: missing $NC — build the toolchain first" >&2; exit 2; }

if [[ "$LIST" -eq 1 ]]; then
  find "$HERE/test" -name '*.sv0' | sed "s#$HERE/##" | sort
  exit 0
fi

declare -a TARGETS=()
if [[ "$SELFTEST" -eq 1 ]]; then
  TARGETS=(test/cases/types_smoke.sv0 test/fixtures/regressions/embedded_nul_len.sv0 test/compile_fail/nested_module.sv0)
elif [[ -n "$DIR" ]]; then
  while IFS= read -r f; do TARGETS+=("${f#"$HERE/"}"); done < <(find "$HERE/$DIR" -name '*.sv0' | sort)
elif [[ "${#CASES[@]}" -gt 0 ]]; then
  for c in "${CASES[@]}"; do
    r="$(resolve_case "$c")"
    [[ -n "$r" ]] || { echo "scripts/test: no such case: $c" >&2; exit 2; }
    TARGETS+=("$r")
  done
else
  while IFS= read -r f; do TARGETS+=("${f#"$HERE/"}"); done < <(find "$HERE/test/cases" -name '*.sv0' | sort)
fi

wrap_lbl=$([[ "$USE_WRAPPER" -eq 1 ]] && echo "driver" || echo "raw/--fast")
log "sv0-strings/scripts/test  backend=$BACKEND  contract-mode=$CONTRACT_MODE  path=$wrap_lbl  toolchain=$TC"
[[ -n "$RECORD" ]] && { : > "$RECORD"; log "  recording -> $RECORD"; }
fails=0
for t in "${TARGETS[@]}"; do
  RC=0; run_one "$t"; fails=$(( fails + RC ))
done
if [[ "$SELFTEST" -eq 1 ]]; then
  dup_main_probe || fails=$(( fails + 1 ))
fi

n="${#TARGETS[@]}"
if [[ "$fails" -gt 0 ]]; then
  echo "scripts/test: $fails failed / $n case(s)"
  exit 1
fi
echo "scripts/test: $n/$n case(s) passed (backend=$BACKEND)"
