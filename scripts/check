#!/usr/bin/env bash
# sv0-strings dependency-free gate: traceability catalogs + doc-fence lint,
# plus generator drift checks when the governing SPEC is reachable. No sv0
# toolchain required. Run before every commit; CI runs this then scripts/test.
#
# SPEC path for the drift checks: $SV0_STRINGS_SPEC, else
# ../project-specs/sv0-strings/SPEC.md relative to the repo root.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$HERE"
fail=0

echo "== check_catalogs =="
python3 tools/check_catalogs.py || fail=1

echo "== check_posix_matrix (POSIX-001 / 013 / 016 / AC-017) =="
python3 tools/check_posix_matrix.py || fail=1

echo "== check_locale_independence (POSIX-014 / ARCH-009) =="
python3 tools/check_locale_independence.py || fail=1

echo "== check_targets (POSIX-015 / DOC-006 fail-closed manifest) =="
python3 tools/check_targets.py || fail=1

echo "== check_traceability (BL-089 bidirectional + unique-ID audit) =="
python3 tools/check_traceability.py || fail=1

echo "== check_fixture_provenance (TEST-004 schema / TEST-006 baseline inventory) =="
python3 tools/check_fixture_provenance.py || fail=1

echo "== check_fuzz_budget (TEST-017 fuzz evidence manifest + budget) =="
python3 tools/check_fuzz_budget.py || fail=1

echo "== check_gate_policy (BACKEND-009 hard-fail lint / TEST-020 fail-closed audit) =="
python3 tools/check_gate_policy.py || fail=1

echo "== check_contract_matrix (TEST-019 / UP-028 / AC-019 contract-mode matrix shape) =="
python3 tools/check_contract_matrix.py || fail=1

echo "== check_accel_matrix (BACKEND-003 / ARCH-007 / AC-020 pure/accelerated equivalence) =="
python3 tools/check_accel_matrix.py || fail=1

echo "== check_complexity_benchmarks (PERF-008 benchmark evidence schema) =="
python3 tools/check_complexity_benchmarks.py || fail=1

echo "== check_consumer_rehearsal (TEST-018 offline clean-checkout rehearsal shape) =="
python3 tools/check_consumer_rehearsal.py || fail=1

echo "== check_acceptance (BL-097 acceptance-scenario evidence binding, AC-001..036) =="
python3 tools/check_acceptance.py || fail=1

echo "== check_release_manifest (BACKEND-007 / GOV-002 content-addressed manifest) =="
python3 tools/check_release_manifest.py || fail=1

echo "== check_doc_fences =="
python3 tools/check_doc_fences.py || fail=1

echo "== compat_doc --check (DOC-004 digest/rebuild) =="
python3 tools/compat_doc.py --check || fail=1

echo "== c_oracle selftest (SS-141) =="
python3 tools/c_oracle/run_oracle.py --selftest || fail=1

echo "== c23 differential vs host libc =="
for d in test/differential/*.py; do
  [[ -e "$d" ]] || continue
  python3 "$d" || fail=1
done

SPEC="${SV0_STRINGS_SPEC:-$HERE/../project-specs/sv0-strings/SPEC.md}"
if [[ -f "$SPEC" ]]; then
  echo "== extract_requirements --check ($SPEC) =="
  python3 tools/extract_requirements.py --spec "$SPEC" --check || fail=1
  echo "== standards_matrix --check =="
  python3 tools/standards_matrix.py --spec "$SPEC" --check || fail=1
else
  echo "-- SPEC not found at $SPEC; skipping generator drift checks --"
fi

[[ "$fail" -eq 0 ]] && echo "scripts/check: PASS" || echo "scripts/check: FAIL"
exit "$fail"
