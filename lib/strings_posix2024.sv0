/// strings_posix2024 -- safe semantic compatibility facade for
/// POSIX.1-2024 Issue 8 `<string.h>` and `<strings.h>`.
///
/// SPEC.md Section 16 and Appendix A.4 / A.5. Includes the C23 facade and
/// adds the Issue 8 extensions (memmem, stpcpy/stpncpy, strlcpy/strlcat,
/// strnlen, strtok_r, strcasecmp family, ffs family, `_l` locale variants,
/// strerror_r/strerror_l/strsignal). Reuses `strings_c23` and the safe
/// modules for common operations (SPEC ARCH-004). Base / CX / XSI
/// classification is explicit; removed historical interfaces are not here.
///
/// R0.4 progress:
///   SS-161  memmem -- IMPLEMENTED (this file). POSIX-002.
///   SS-162  stpcpy / stpncpy -- IMPLEMENTED (this file). POSIX-003.
///   SS-163  strlcpy / strlcat -- IMPLEMENTED (this file). POSIX-004.
///   SS-164  strnlen -- IMPLEMENTED (this file). POSIX-005.
///   SS-165  strtok_r -- IMPLEMENTED (this file). POSIX-006.
///   SS-166  strcasecmp / strncasecmp (POSIX-locale) -- IMPLEMENTED (this
///           file). POSIX-007 / POSIX-017 / ASCII-007.
///   SS-168  strcoll_l / strxfrm_l / strxfrm_l_size -- explicit-locale `_l`
///           compare/transform adapters, capability STUBS (this file).
///           POSIX-008 / POSIX-009 / HOST-003. Every call returns
///           `HostCapability::Unsupported` for EVERY `LocaleId` on both
///           backends -- the versioned host-capability ABI (toolchain slice
///           SS-U12) is deferred, so no `Locale` can be opened and there is
///           no collation service to delegate to. NEVER a bytewise/ASCII
///           collation substitute (HOST-004 / SPEC B.7). The HOST-003
///           transform/compare consistency contract these MUST satisfy once
///           SS-U12 lands is `docs/l-locale-adapters.md`.
///   SS-169  strerror_r / strerror_l / strsignal -- owned host error /
///           signal message capability, STUBS (this file). POSIX-010 /
///           POSIX-011 / HOST-005 / HOST-006. `strerror_r` returns
///           `MessageWrite::Unavailable` (bounded caller-buffer form,
///           `dst` untouched); `strerror_l` / `strsignal` return
///           `HostMessage::Unavailable` (owned-string form). sv0 has no
///           FFI / host-call primitive yet (`strings_unsafe_abi` is
///           Future, BL-103/104), so there is no OS message table to read
///           -- NEVER a synthesized message, NEVER a libc static borrow.
///           Contract: `docs/host-message-capability.md`.
///   SS-170  ffs / ffsl / ffsll -- XSI explicit-width find-first-set
///           adapters, IMPLEMENTED (this file). POSIX-012. Pure bit ops,
///           no host dependency: `0` -> `0`; nonzero -> the 1-based index
///           of the least-significant set bit. `ffs` takes `i32`, `ffsl` /
///           `ffsll` take `i64`; all return `usize` (MODEL-002). XSI
///           subprofile only. Differential-checked vs host libc.
module strings_posix2024;

use strings_types::Option;
use strings_types::Ordering;
use strings_types::EndOffsetResult;
use strings_types::CopyReport;
use strings_types::AppendResult;
use strings_types::TokenStep;
use strings_types::HostCapability;
use strings_types::HostMessage;
use strings_types::MessageWrite;
use strings_bytes::find_slice;
use strings_cstr::copy_into;
use strings_cstr::append_into;
use strings_ascii::compare_ignore_case;
use strings_ascii::to_lower;
use strings_cstr::as_bytes;
use strings_c23::strtok;
use strings_locale::LocaleId;

/// First `0x00` in `buf` within `limit`, else `limit` -- the effective end
/// of a bounded, possibly non-terminated source (local copy of the helper
/// `strings_c23` uses privately).
fn bound_to_nul(buf: &[byte], limit: usize) -> usize {
    let mut i: usize = 0;
    while i < limit
        loop_invariant(i <= limit)
    {
        if buf[i] == 0 { return i; }
        i = i + 1;
    }
    return limit;
}

/// POSIX-002 (Adapted). Binary-safe substring search: the offset of the
/// first occurrence of `needle` within `haystack`, or `Option::None`.
/// Delegates directly to `strings_bytes::find_slice`, which scans raw
/// bytes with no NUL semantics -- an embedded `0x00` in EITHER `haystack`
/// or `needle` is just another byte value (SPEC ARCH-004: reuse the safe
/// module). An empty `needle` yields `Option::Some(0)` (matching POSIX
/// Issue 8 / glibc >= 2.30, which return `haystack`); a `needle` longer
/// than `haystack` yields `Option::None`.
///
/// DEVIATION from C `memmem` (POSIX): returns `Option<usize>`, an offset,
/// never an interior pointer -- so it cannot dangle past `haystack`.
pub fn memmem(haystack: &[byte], needle: &[byte]) -> Option<usize> {
    return find_slice(haystack, needle);
}

/// POSIX-003 (Adapted). Copy the whole `CStr` payload of `src` plus one
/// terminator into `dst`, and return the offset of that terminator
/// (`EndOffsetResult::EndAt(payload.len())`) -- C `stpcpy` returns a
/// pointer to the same position; this returns it as an offset, never a raw
/// interior pointer (POSIX-003). `dst` must have room for the full payload;
/// insufficient capacity is `DestinationTooSmall(need, have)` with `dst`
/// unmodified (C `stpcpy` would overrun).
pub fn stpcpy(dst: &mut [byte], src: string) -> EndOffsetResult {
    let cap: usize = slice_len(dst);
    let plen: usize = string_len(src);
    if plen + 1 > cap {
        return EndOffsetResult::DestinationTooSmall(plen + 1, cap);
    }
    let mut i: usize = 0;
    while i < plen
        loop_invariant(i <= plen)
        loop_invariant(plen + 1 <= cap)
    {
        dst[i] = string_char_at(src, i);
        i = i + 1;
    }
    dst[plen] = 0;
    return EndOffsetResult::EndAt(plen);
}

/// POSIX-003 (Adapted). Bounded, zero-padded copy of `src` into `dst`,
/// preserving C `stpncpy`'s exact end-position and padding rules: bytes are
/// copied through the first `0x00` within `[0, min(n, src.len()))` (or
/// through the whole window when none exists), then the remainder of
/// `dst[0..n]` is zero-filled. The returned offset is C's `stpncpy` end
/// position -- `dst + strnlen(src, n)`, i.e. the first `0x00` within the
/// bound, or `n` when the source is not terminated within `n` (in which
/// case no terminator is written, exactly like C). Returned as an
/// `EndOffsetResult::EndAt(offset)`, never a raw pointer.
///
/// `src` need not be `n` bytes long or contain a `0x00`; the copy window is
/// bounded by the slice's own length, so nothing is ever read past it.
/// `n > dst.len()` is `DestinationTooSmall(n, dst.len())`, `dst` unmodified.
pub fn stpncpy(dst: &mut [byte], src: &[byte], n: usize) -> EndOffsetResult {
    let cap: usize = slice_len(dst);
    if n > cap {
        return EndOffsetResult::DestinationTooSmall(n, cap);
    }
    let avail: usize = slice_len(src);
    let mut lim: usize = n;
    if lim > avail { lim = avail; }
    let stop: usize = bound_to_nul(src, lim);

    let mut i: usize = 0;
    while i < stop
        loop_invariant(i <= stop)
        loop_invariant(stop <= n)
        loop_invariant(n <= cap)
    {
        dst[i] = src[i];
        i = i + 1;
    }
    while i < n
        loop_invariant(i <= n)
        loop_invariant(stop <= i)
        loop_invariant(n <= cap)
    {
        dst[i] = 0;
        i = i + 1;
    }
    return EndOffsetResult::EndAt(stop);
}

/// POSIX-004 (Adapted). Size-bounded copy of the `CStr` payload `src` into
/// `dst`, the C23-recognizable name for `strings_cstr::copy_into`
/// (`strlcpy` semantics, SPEC Appendix A.4 / CSTR-011). The `CopyReport`
/// carries the **total attempted length** as `required` (`src.len()`),
/// `written` = payload bytes actually copied (`min(required, dst.len() -
/// 1)`, or 0 at zero capacity), and `truncated` iff `required >= dst.len()`.
/// When capacity is nonzero the result is NUL-terminated. Zero-length
/// `dst`: no access through the slice, `written == 0`, `truncated == true`
/// (matching the conventional `strlcpy` return-value test).
///
/// DEVIATION from C `strlcpy`: returns a `CopyReport`, not the bare
/// attempted length -- truncation is a field, not a value the caller has
/// to re-derive.
pub fn strlcpy(dst: &mut [byte], src: string) -> CopyReport {
    return copy_into(dst, src);
}

/// POSIX-004 (Adapted). Size-bounded append of the `CStr` payload `src`
/// onto the C-string in `dst`, bounding the initial destination scan by
/// `dstsize` -- the C23-recognizable name for `strings_cstr::append_into`
/// (`strlcat` semantics, CSTR-012 / AC-027). `dstsize` is clamped to
/// `dst.len()` (POSIX-004: "checks `dstsize <= storage.len()`"); the
/// bounded destination is `dst[0..dstsize]`.
///
/// - A first `0x00` at offset `f` within `dstsize`: append
///   `min(src.len(), dstsize - f - 1)` bytes after it, re-terminate;
///   `required = f + src.len()` (the total attempted length).
/// - **No `0x00` in the first `dstsize` bytes** (AC-027): write NOTHING,
///   every destination byte preserved, `required = dstsize + src.len()`,
///   `truncated`.
/// - `f + src.len()` (or `dstsize + src.len()`) is checked for `usize`
///   overflow **before any modification** and returns
///   `AppendResult::LengthOverflow`.
pub fn strlcat(dst: &mut [byte], src: string, dstsize: usize) -> AppendResult {
    let cap: usize = slice_len(dst);
    let mut ds: usize = dstsize;
    if ds > cap { ds = cap; }
    return append_into(&mut dst[0..ds], src);
}

/// POSIX-005 (Adapted). Length of the initial run of non-`0x00` bytes in
/// `s`, inspecting **at most `n` bytes** and returning `min(first_0x00,
/// n)` -- `s` need NOT contain a `0x00` within the bound. The scan window
/// is clamped to `min(n, s.len())`, so a caller may pass any `n` (even far
/// past the slice) and the scan still never reads past `s`'s own bound
/// (the "guard-page" safety C `strnlen` places on the caller instead).
///
/// DEVIATION from C `strnlen`: `s` is a length-bearing slice, so passing an
/// `n` larger than the readable region is defined here (clamped) rather
/// than the caller's obligation.
pub fn strnlen(s: &[byte], n: usize) -> usize {
    let avail: usize = slice_len(s);
    let mut lim: usize = n;
    if lim > avail { lim = avail; }
    return bound_to_nul(s, lim);
}

/// POSIX-006 (Adapted). Reentrant tokenizer: `TokenStep::Emit(start, end,
/// next_pos)` gives the next token of the `CStr` payload `s` as
/// `s[start..end]`; call again with `pos = next_pos` to resume.
/// `TokenStep::Complete` means no more tokens.
///
/// The C `strtok_r` distinction from `strtok` is that its continuation
/// state lives in a caller-owned `char **saveptr` rather than a hidden
/// global. The safe façade's `strtok` (SS-147) is *already* in that form --
/// the caller threads `pos: usize` explicitly and nothing global is
/// touched -- so `strtok_r` is the same function under the
/// POSIX-recognizable name (it delegates to `strings_c23::strtok`).
/// The separator set MAY change between calls (TOK-009), and two
/// tokenizations that thread their own `pos` never interfere (proven by
/// interleaving them in the fixture). The safe native tokenizer never
/// mutates `s` -- unlike C `strtok_r`, which overwrites each consumed
/// separator with `0x00` (POSIX-006: "the safe native tokenizer remains
/// non-mutating; the façade SHALL document this adaptation").
pub fn strtok_r(s: string, separators: string, pos: usize) -> TokenStep {
    return strtok(s, separators, pos);
}

/// POSIX-007 / ASCII-007 (Adapted). Case-insensitive comparison of the
/// `CStr` payloads of `a` and `b` for the **POSIX locale profile**: an
/// ASCII `A`..`Z` <-> `a`..`z` fold (`strings_ascii::to_lower`), every
/// other byte compared as-is. **Independent of the ambient process
/// locale** -- there is no locale query; a locale-aware comparison
/// requires the explicit capability model (SS-167/168, Section 17,
/// Host-dependent). Delegates to `strings_ascii::compare_ignore_case` over
/// the payload bytes.
///
/// DEVIATION from C `strcasecmp` (POSIX): returns `Ordering`, not an
/// arbitrary signed magnitude; the POSIX-locale profile is explicit
/// (non-"C"/"POSIX" locale behavior is out of scope here).
pub fn strcasecmp(a: string, b: string) -> Ordering {
    return compare_ignore_case(as_bytes(a), as_bytes(b));
}

/// POSIX-017 / AC-028 (Adapted). Compare at most `n` case-folded bytes of
/// `a` and `b`, **stopping at the first `0x00` within that bound on each
/// side** (whichever comes first, NUL or `n`). `a` / `b` are bounded
/// initialized byte sources that need NOT contain a `0x00` within their
/// first `n` bytes; the scan window is clamped to `min(n, side.len())`, so
/// nothing is ever read past either slice. Same POSIX-locale ASCII fold
/// and locale-independence as `strcasecmp`.
pub fn strncasecmp(a: &[byte], b: &[byte], n: usize) -> Ordering {
    let acap: usize = slice_len(a);
    let bcap: usize = slice_len(b);
    let mut abound: usize = n;
    if abound > acap { abound = acap; }
    let mut bbound: usize = n;
    if bbound > bcap { bbound = bcap; }
    let ae: usize = bound_to_nul(a, abound);
    let be: usize = bound_to_nul(b, bbound);

    let mut m: usize = ae;
    if be < m { m = be; }
    let mut i: usize = 0;
    while i < m
        loop_invariant(i <= m)
        loop_invariant(m <= acap)
        loop_invariant(m <= bcap)
    {
        let av: byte = to_lower(a[i]);
        let bv: byte = to_lower(b[i]);
        if av < bv { return Ordering::Less; }
        if av > bv { return Ordering::Greater; }
        i = i + 1;
    }
    if ae < be { return Ordering::Less; }
    if ae > be { return Ordering::Greater; }
    return Ordering::Equal;
}

/// POSIX Issue 8 `strcoll_l` (XSI; the `_l` explicit-locale variant of C's
/// `strcoll`). Three-way locale-sensitive collation of `a` and `b` under
/// the locale named by `loc` -- and ONLY that locale: the defining property
/// of the `_l` forms is that they never consult `LC_COLLATE` or any ambient
/// process locale (POSIX-008 / HOST-001).
///
/// **Always `HostCapability::Unsupported` today**, for EVERY `loc`
/// including `LocaleId::Posix`. The versioned host-capability ABI with
/// equivalent VM behavior (toolchain slice SS-U12, SPEC UP-015 / OQ-005) is
/// deferred, so `strings_locale::open` returns `Unavailable` for every id,
/// no `Locale` object can be constructed, and there is no collation service
/// for this adapter to delegate to on either backend. This NEVER degrades
/// to `strings_bytes::compare` or any bytewise / ASCII ordering: SPEC B.7
/// requires that a locale whose fold/collation rules differ from ASCII
/// (e.g. Turkish dotless-i) yield a typed "unsupported", never a silent
/// mis-ordering (HOST-004). Consistency contract with `strxfrm_l`:
/// `docs/l-locale-adapters.md`.
pub fn strcoll_l(a: string, b: string, loc: LocaleId) -> HostCapability {
    match loc {
        LocaleId::Posix => {},
        LocaleId::HostNamed(_name) => {},
    }
    return HostCapability::Unsupported;
}

/// POSIX Issue 8 `strxfrm_l` (XSI). Transform `src` into its collation key
/// for locale `loc`, writing only within `dst`, such that a plain bytewise
/// comparison (`strings_bytes::compare`) of two keys produced for the same
/// `loc` has the SAME SIGN as `strcoll_l` of the two original inputs under
/// `loc` (HOST-003 / POSIX-009). `loc` is the same explicit `LocaleId`
/// passed to `strcoll_l`; no ambient locale is read.
///
/// **Always `HostCapability::Unsupported` today** (same reason as
/// `strcoll_l`). `dst` is left completely untouched -- no partial,
/// truncated, or synthesized key is ever written, so a caller cannot
/// mistake stale destination bytes for a real collation key.
pub fn strxfrm_l(dst: &mut [byte], src: string, loc: LocaleId) -> HostCapability {
    match loc {
        LocaleId::Posix => {},
        LocaleId::HostNamed(_name) => {},
    }
    return HostCapability::Unsupported;
}

/// Size query for `strxfrm_l`: the number of bytes a collation key for
/// `src` under `loc` would occupy. Takes **no** destination -- sv0's
/// owned-buffer idiom (query size, allocate, transform) replaces C's
/// "call with a NULL / zero-length destination to learn the size" dance
/// (mirrors `strings_c23::strxfrm_size`, SS-151).
///
/// **Always `HostCapability::Unsupported` today** (same reason as
/// `strcoll_l` / `strxfrm_l`).
pub fn strxfrm_l_size(src: string, loc: LocaleId) -> HostCapability {
    match loc {
        LocaleId::Posix => {},
        LocaleId::HostNamed(_name) => {},
    }
    return HostCapability::Unsupported;
}

/// POSIX Issue 8 `strerror_r` (the POSIX, thread-safe form -- NOT the GNU
/// `char *` return form). Write the host's description of `errnum` into
/// `dst`, bounded by `dst`'s capacity, and report whether it fit
/// (POSIX-010). The safe adapter touches **only** `dst` -- it never
/// returns a pointer into, or copies out of, a libc static / process-global
/// buffer (POSIX-010 / SEC-011).
///
/// **Always `MessageWrite::Unavailable` today**: sv0 has no host-call / FFI
/// primitive yet (`strings_unsafe_abi` is Future work, BL-103/104), so
/// there is no OS message table to read. `dst` is left **completely
/// untouched** -- no partial or synthesized message is ever written. There
/// is no branch on `errnum`, so the C23-030 "every `i32` is a valid
/// argument" property is trivially satisfied (every input yields
/// `Unavailable`).
pub fn strerror_r(errnum: i32, dst: &mut [byte]) -> MessageWrite {
    return MessageWrite::Unavailable;
}

/// POSIX Issue 8 `strerror_l` -- `strerror` under an explicit locale
/// (POSIX-011 / HOST-005). Returns the message as an **owned** sv0 string,
/// never a borrow of a libc static (HOST-005). `loc` is an explicit
/// `strings_locale::LocaleId`; no ambient process locale is read.
///
/// **Always `HostMessage::Unavailable` today** (same reason as
/// `strerror_r`; additionally there is no openable `Locale` while SS-U12
/// is deferred). Never a synthesized or approximated message. The message
/// text, once real, is not a stable protocol identifier -- branch on the
/// `i32` `errnum` (HOST-006).
pub fn strerror_l(errnum: i32, loc: LocaleId) -> HostMessage {
    match loc {
        LocaleId::Posix => {},
        LocaleId::HostNamed(_name) => {},
    }
    return HostMessage::Unavailable;
}

/// POSIX Issue 8 `strsignal` -- the host's description of signal `signum`
/// as an **owned** sv0 string (POSIX-011 / HOST-005).
///
/// **Always `HostMessage::Unavailable` today** (same reason as
/// `strerror_r`). No branch on `signum`; the eventual message text is not a
/// stable protocol identifier -- branch on the `i32` `signum` (HOST-006).
pub fn strsignal(signum: i32) -> HostMessage {
    return HostMessage::Unavailable;
}

/// 1-based index of the least-significant set bit of `bits`, or `0` when
/// `bits` is zero. Scans with `>> 1`: this stops the moment the lowest set
/// bit reaches position 0, which for a value at position `p` happens after
/// exactly `p` shifts -- always before any bit shifted in from the top
/// (whether `0` or a sign copy) can reach position 0 -- so the sign of
/// `bits` and whether `>>` is arithmetic or logical do not affect the
/// result. `>> 1` of a negative signed value is implementation-defined (not
/// UB) and every supported backend arithmetic-shifts; `1 << 63` is never
/// formed, so there is no signed-overflow UB either (`scripts/sanitize`
/// stays quiet). Uses `i64` rather than `usize` because the `i64 -> usize`
/// cast currently narrows through `int` in the C backend.
fn ffs_bits(bits: i64) -> usize {
    if bits == 0 {
        return 0;
    }
    let mut v: i64 = bits;
    let mut pos: usize = 1;
    while (v & 1) == 0
        loop_invariant(pos >= 1)
        loop_invariant(pos <= 64)
    {
        v = v >> 1;
        pos = pos + 1;
    }
    return pos;
}

/// POSIX Issue 8 `ffs` (XSI). Find-first-set: return the 1-based position
/// of the least-significant set bit of `value`, or `0` if `value` is `0`
/// (POSIX-012). Operates on the two's-complement bit pattern, so a negative
/// `value` is well-defined -- `ffs(i32::MIN)` is `32` (`value as i64`
/// sign-extends; the sign copies land above bit 31, never at or below the
/// lowest set bit). Result is `usize` (MODEL-002), always in `0..=32`.
pub fn ffs(value: i32) -> usize {
    return ffs_bits(value as i64);
}

/// POSIX Issue 8 `ffsl` (XSI). `ffs` for a `long`-width value: 1-based
/// position of the least-significant set bit of `value`, or `0` if `value`
/// is `0` (POSIX-012). Result is `usize`, always in `0..=64`.
pub fn ffsl(value: i64) -> usize {
    return ffs_bits(value);
}

/// POSIX Issue 8 `ffsll` (XSI). `ffs` for a `long long`-width value; in sv0
/// `long` and `long long` are both 64-bit, so this shares `ffsl`'s
/// semantics: 1-based position of the least-significant set bit, or `0`
/// (POSIX-012). Result is `usize`, always in `0..=64`.
pub fn ffsll(value: i64) -> usize {
    return ffs_bits(value);
}
