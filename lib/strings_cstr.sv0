/// strings_cstr -- validated borrowed `CStr`, owned `CString`, and (SS-128)
/// bounded mutable `CBuffer`.
///
/// SPEC.md Section 13. SS-126 landed the `CStr` / `CString` constructors and
/// views: from_bytes_with_nul, from_bytes_until_nul, from_text, from_bytes,
/// borrow, as_bytes, as_bytes_with_nul, len, to_text. SS-127 added
/// `clone_owned` / `concat`. SS-128 adds the `CBuffer` family: copy_into
/// (strlcpy), append_into (strlcat), buffer_from_storage, empty_buffer,
/// require_cstr.
///
/// DEVIATION D-8 (docs/f0-deviations.md): a `CBuffer` value is exactly its
/// backing `&mut [byte]` storage (a `struct` with a `&mut [byte]` field
/// crashes the C emitter, KC-006 zone). Its capacity is `slice_len(storage)`
/// and the "first NUL" state is RECOMPUTED by a bounded scan of `storage`
/// rather than cached in the value -- behaviour is identical to the cached
/// model, and buffer mutation can never leave a stale cache (CSTR-016 is
/// trivially satisfied). The `borrows(...)` relation is advisory.
///
/// DEVIATION D-7 (docs/f0-deviations.md): `CStr` and `CString` are both an
/// owned `string` -- an enum variant carrying a struct payload does not lower
/// on the C backend (R0.3 struct-in-enum limit). A `CStr` value is the
/// validated NUL-free payload; a `CString` value is `<payload><0x00>`. The
/// SPEC `borrows(...)` relations are advisory: the bytes are copied at
/// construction (SS-U16 `string_from_bytes`), so no view can dangle, and the
/// "no rescan / no re-alloc after validated construction" invariants
/// (CSTR-003 / CSTR-017) hold because the payload length travels with the
/// value.
module strings_cstr;

use strings_types::CStrResult;
use strings_types::CStringResult;
use strings_types::ConcatResult;
use strings_types::CopyReport;
use strings_types::AppendResult;
use strings_types::FromUtf8Result;
use strings_text::from_utf8;
use strings_checked::checked_add;
use strings_checked::CheckedUsize;

/// CSTR-001 (R0.2): accept only a slice whose final byte is `0x00` and whose
/// preceding bytes contain no `0x00`. An empty slice has no terminator.
pub fn from_bytes_with_nul(bytes: &[byte]) -> CStrResult {
    let n: usize = slice_len(bytes);
    if n == 0 { return CStrResult::NoTerminator; }
    if bytes[n - 1] != 0 { return CStrResult::NoTerminator; }
    let mut i: usize = 0;
    while i + 1 < n
        loop_invariant(i <= n)
    {
        if bytes[i] == 0 { return CStrResult::InteriorAt(i); }
        i = i + 1;
    }
    return CStrResult::View(string_from_bytes(&bytes[0..n - 1]));
}

/// CSTR-002 (R0.2): view the payload up to (excluding) the FIRST `0x00`;
/// bytes after it are outside the resulting `CStr`. Absence of `0x00`
/// returns `NoTerminator` (`CStrError::MissingTerminator`).
pub fn from_bytes_until_nul(bytes: &[byte]) -> CStrResult {
    let n: usize = slice_len(bytes);
    let mut i: usize = 0;
    while i < n
        loop_invariant(i <= n)
    {
        if bytes[i] == 0 {
            return CStrResult::View(string_from_bytes(&bytes[0..i]));
        }
        i = i + 1;
    }
    return CStrResult::NoTerminator;
}

/// CSTR-005 (R0.2): reject an embedded U+0000; otherwise preserve the exact
/// UTF-8 payload and append one terminator.
pub fn from_text(value: string) -> CStringResult {
    let n: usize = string_len(value);
    let mut i: usize = 0;
    while i < n
        loop_invariant(i <= n)
    {
        if string_char_at(value, i) == 0 { return CStringResult::InteriorAt(i); }
        i = i + 1;
    }
    return CStringResult::Owned(string_concat(value, "\0"));
}

/// CSTR-006 (R0.2): permit non-UTF-8 payload bytes, reject an interior
/// `0x00`, append one terminator, return owned storage.
pub fn from_bytes(bytes: &[byte]) -> CStringResult {
    let n: usize = slice_len(bytes);
    let mut i: usize = 0;
    while i < n
        loop_invariant(i <= n)
    {
        if bytes[i] == 0 { return CStringResult::InteriorAt(i); }
        i = i + 1;
    }
    return CStringResult::Owned(string_concat(string_from_bytes(bytes), "\0"));
}

/// CSTR-017 (R0.2): borrow a `CString` as a `CStr` -- the payload without
/// the trailing terminator. The first-NUL invariant is already established
/// (a `CString` value carries exactly one trailing `0x00`), so this does
/// not rescan for a terminator; it performs a single bounded substring.
pub fn borrow(value: string) -> string {
    let n: usize = string_len(value);
    if n == 0 { return value; }
    return string_substr(value, 0, n - 1);
}

/// CSTR-003 (R0.2): payload byte count, terminator excluded. A `CStr` value
/// carries only its NUL-free payload, so this is a stored length -- no
/// rescan.
pub fn len(value: string) -> usize {
    return string_len(value);
}

/// CSTR-004 (R0.2): `as_bytes` excludes the terminator. A `CStr` value is
/// already NUL-free, so this is the whole view.
pub fn as_bytes(value: string) -> &[byte] {
    return string_byte_view(value);
}

/// CSTR-004 (R0.2): `as_bytes_with_nul` includes exactly one terminator.
pub fn as_bytes_with_nul(value: string) -> &[byte] {
    return string_byte_view(string_concat(value, "\0"));
}

/// CSTR-007 (R0.2): validate the payload as UTF-8; invalid bytes return a
/// `TextError` (`FromUtf8Result::Invalid`) with no lossy replacement. The
/// `Ok` string is a fresh owned copy of the payload.
pub fn to_text(value: string) -> FromUtf8Result {
    return from_utf8(string_byte_view(value));
}

/// CSTR-008 (R0.2): a fresh owned `CString` copy of `value` (a `CStr`
/// payload) with one appended terminator. `len(value) + 1` is checked for
/// `usize` overflow before allocation; on `ConcatResult::LengthOverflow`
/// nothing is allocated and `value` is unchanged. A genuine allocation
/// failure is not recoverable here -- the owned allocator fails closed
/// (`sv0_panic`, D-7 / SS-U02b/d) -- and still leaves `value` unchanged.
///
/// Returned via `strings_types::ConcatResult` (`Joined` / `LengthOverflow`);
/// the SPEC `Result<CString, BufferError>` form hits the D-4 gap.
pub fn clone_owned(value: string) -> ConcatResult {
    let total: CheckedUsize = checked_add(string_len(value), 1);
    let over: bool = match total {
        CheckedUsize::Overflow => { true },
        CheckedUsize::Ok(_n) => { false },
    };
    if over {
        return ConcatResult::LengthOverflow;
    }
    return ConcatResult::Joined(string_concat(value, "\0"));
}

/// CSTR-009 (R0.2): a new owned `CString` equal to the payload of `a`,
/// followed by the payload of `b`, followed by exactly one terminator.
/// `len(a) + len(b)` and then `+ 1` for the terminator are checked for
/// `usize` overflow BEFORE any allocation; on `LengthOverflow` nothing is
/// allocated and both inputs are unchanged (they are immutable handles). One
/// `string_concat` chain builds the result.
pub fn concat(a: string, b: string) -> ConcatResult {
    let sum: CheckedUsize = checked_add(string_len(a), string_len(b));
    let payload_len: usize = match sum {
        CheckedUsize::Ok(n) => { n },
        CheckedUsize::Overflow => { 0 },
    };
    let sum_over: bool = match sum {
        CheckedUsize::Ok(_n) => { false },
        CheckedUsize::Overflow => { true },
    };
    if sum_over {
        return ConcatResult::LengthOverflow;
    }
    let withterm: CheckedUsize = checked_add(payload_len, 1);
    let term_over: bool = match withterm {
        CheckedUsize::Ok(_n) => { false },
        CheckedUsize::Overflow => { true },
    };
    if term_over {
        return ConcatResult::LengthOverflow;
    }
    let joined: string = string_concat(a, b);
    return ConcatResult::Joined(string_concat(joined, "\0"));
}

/// First `0x00` in the bounded storage `buf`, or `slice_len(buf)` when none
/// exists (D-8: recomputed, never cached). Never reads past `slice_len`.
fn first_nul(buf: &[byte]) -> usize {
    let cap: usize = slice_len(buf);
    let mut i: usize = 0;
    while i < cap
        loop_invariant(i <= cap)
    {
        if buf[i] == 0 { return i; }
        i = i + 1;
    }
    return cap;
}

/// CSTR-010 (R0.2): adopt `storage` as a `CBuffer`. With the recompute model
/// (D-8) there is nothing to scan or cache at construction; the value is the
/// storage itself.
pub fn buffer_from_storage(storage: &mut [byte]) -> &mut [byte] {
    return storage;
}

/// CSTR-010 (R0.2): a `CBuffer` in the empty state -- write `0x00` at index 0
/// when capacity is nonzero; at zero capacity write nothing. Either way the
/// value is the storage.
pub fn empty_buffer(storage: &mut [byte]) -> &mut [byte] {
    if slice_len(storage) > 0 {
        storage[0] = 0;
    }
    return storage;
}

/// CSTR-011 (R0.2): bounded `strlcpy` into `dst`. When capacity is nonzero,
/// write `min(src.len(), capacity - 1)` payload bytes then one terminator;
/// `written` = payload bytes copied, `required` = `src.len()` (CSTR-018),
/// `truncated` = `required >= capacity` (derived from the bound, not from
/// `written`). At zero capacity: write nothing, `written = 0`, `truncated`
/// is true even for an empty source (CSTR-013). `src` is a `CStr` payload
/// (NUL-free).
pub fn copy_into(dst: &mut [byte], src: string) -> CopyReport {
    let cap: usize = slice_len(dst);
    let need: usize = string_len(src);
    if cap == 0 {
        return CopyReport { written: 0, required: need, truncated: true };
    }
    let room: usize = cap - 1;
    let mut w: usize = need;
    if w > room { w = room; }
    let mut i: usize = 0;
    while i < w
        loop_invariant(i <= w)
        loop_invariant(w <= room)
    {
        dst[i] = string_char_at(src, i);
        i = i + 1;
    }
    dst[w] = 0;
    let mut trunc: bool = false;
    if need >= cap { trunc = true; }
    return CopyReport { written: w, required: need, truncated: trunc };
}

/// CSTR-012 (R0.2): bounded `strlcat` over the whole `CBuffer`. If a first
/// `0x00` exists at offset `f`, append `min(src.len(), capacity - f - 1)`
/// payload bytes after it and re-terminate; `required = f + src.len()`. If
/// no first `0x00` exists, write nothing and `required = capacity +
/// src.len()`. `first_nul + src.len()` (or `capacity + src.len()`) is
/// checked for `usize` overflow BEFORE any modification and returns
/// `LengthOverflow`; otherwise `truncated = required >= capacity`. `src` is
/// a `CStr` payload (NUL-free).
pub fn append_into(dst: &mut [byte], src: string) -> AppendResult {
    let cap: usize = slice_len(dst);
    let need: usize = string_len(src);
    let f: usize = first_nul(dst);

    if f == cap {
        let ovf: CheckedUsize = checked_add(cap, need);
        let ovf_req: usize = match ovf {
            CheckedUsize::Ok(n) => { n },
            CheckedUsize::Overflow => { 0 },
        };
        let ovf_bad: bool = match ovf {
            CheckedUsize::Ok(_n) => { false },
            CheckedUsize::Overflow => { true },
        };
        if ovf_bad {
            return AppendResult::LengthOverflow;
        }
        return AppendResult::Reported(0, ovf_req, true);
    }

    let chk: CheckedUsize = checked_add(f, need);
    let req: usize = match chk {
        CheckedUsize::Ok(n) => { n },
        CheckedUsize::Overflow => { 0 },
    };
    let overflowed: bool = match chk {
        CheckedUsize::Ok(_n) => { false },
        CheckedUsize::Overflow => { true },
    };
    if overflowed {
        return AppendResult::LengthOverflow;
    }

    let room: usize = cap - f - 1;
    let mut w: usize = need;
    if w > room { w = room; }
    let mut k: usize = 0;
    while k < w
        loop_invariant(k <= w)
        loop_invariant(w <= room)
    {
        dst[f + k] = string_char_at(src, k);
        k = k + 1;
    }
    dst[f + w] = 0;

    let mut trunc: bool = false;
    if req >= cap { trunc = true; }
    return AppendResult::Reported(w, req, trunc);
}

/// CSTR-017 (R0.2): the payload up to the first `0x00` of the `CBuffer`, as
/// a `CStr` (`CStrResult::View`); `NoTerminator` when the bounded storage
/// holds no `0x00`. The first-NUL state is recomputed by a bounded scan
/// (D-8); the payload is copied into the `CStr` value (D-7).
pub fn require_cstr(value: &[byte]) -> CStrResult {
    let f: usize = first_nul(value);
    if f == slice_len(value) {
        return CStrResult::NoTerminator;
    }
    return CStrResult::View(string_from_bytes(&value[0..f]));
}
