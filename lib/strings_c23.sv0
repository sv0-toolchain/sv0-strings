/// strings_c23 -- safe semantic compatibility facade for ISO C23
/// `<string.h>` (Section 7.26 / B.25).
///
/// SPEC.md Section 15 and Appendix A.2. Source-recognizable names with
/// C23-equivalent results for inputs on which C defines behavior, using
/// safe sv0 reference / slice / result / ownership types. Semantic
/// compatibility, not binary ABI compatibility. C undefined behavior is
/// translated to typed errors, contracts, or `CStr`/`CBuffer` constraints.
/// Adapts shared safe implementations rather than duplicating algorithms
/// (SPEC ARCH-003).
///
/// R0.3 progress:
///   SS-142  memcpy / memmove / memmove_within / memccpy -- IMPLEMENTED
///           (this file). C23-004 / C23-005.
///   SS-143  memchr / strchr / strrchr / strpbrk / strstr (search) and
///           memcmp / strcmp / strncmp (comparison) -- IMPLEMENTED (this
///           file). C23-006 / C23-007.
///   SS-144  strcpy / strncpy / strcat / strncat -- IMPLEMENTED (this
///           file). C23-008 / C23-009 / C23-010.
///   SS-145  strdup / strndup -- IMPLEMENTED (this file). C23-011.
///   SS-146  strspn / strcspn -- IMPLEMENTED (this file). C23-012.
///   SS-147  strtok -- IMPLEMENTED (this file). C23-013.
///   SS-148  memset -- IMPLEMENTED (this file); memset_explicit stays
///           Blocked (BYTE-010, docs/fill-explicit-blocked.md), same as
///           `strings_bytes::fill_explicit` -- NOT exported here either.
///           C23-014.
///   SS-149  strlen -- IMPLEMENTED (this file). C23-015.
///   SS-150  strcoll / strxfrm / strerror -- capability STUBS (this file):
///           always Unsupported, fail closed, no bytewise/synthesized
///           substitute. C23-016 / C23-017.
///   SS-151  terminator search (strchr/strrchr with 0), exact-integer
///           strchr_int/strrchr_int (int c -> char), strxfrm_size query
///           form, + fixtures pinning C23-021..030. C23-021..030.
module strings_c23;

use strings_types::CopyResult;
use strings_types::MoveResult;
use strings_types::MemccpyReport;
use strings_types::Ordering;
use strings_types::Option;
use strings_types::ConcatResult;
use strings_types::TokenStep;
use strings_types::HostCapability;
use strings_bytes::copy;
use strings_bytes::move_within;
use strings_bytes::find;
use strings_bytes::rfind;
use strings_bytes::find_slice;
use strings_bytes::span_in;
use strings_bytes::span_not_in;
use strings_bytes::compare;
use strings_bytes::fill;
use strings_cstr::as_bytes;
use strings_cstr::clone_owned;
use strings_cstr::len;
use strings_checked::checked_add;
use strings_checked::CheckedUsize;
use strings_tokenize::next;

/// C23-004 (Adapted). Copy `n` bytes of `src` into `dst`. Overlap is a
/// compile-time borrow exclusion: two distinct safe slice arguments cannot
/// alias (a caller who passes `&mut b[..]` and `&b[..]` is rejected with
/// `E0323`), so this delegates to `strings_bytes::copy`, the non-overlapping
/// element-wise primitive.
///
/// DEVIATION from C `memcpy` (C23-003): returns `CopyResult`, not the `dst`
/// pointer; `n` exceeding the destination capacity or the available source
/// is `DestinationTooSmall(need, have)` with `dst` unmodified, never UB.
pub fn memcpy(dst: &mut [byte], src: &[byte], n: usize) -> CopyResult {
    let cap: usize = slice_len(dst);
    let avail: usize = slice_len(src);
    if n > cap {
        return CopyResult::DestinationTooSmall(n, cap);
    }
    if n > avail {
        return CopyResult::DestinationTooSmall(n, avail);
    }
    return copy(&mut dst[0..n], &src[0..n]);
}

/// C23-004 (Adapted). Copy `n` bytes of `src` into `dst`, overlap-tolerant.
/// In the safe façade two distinct slice arguments cannot alias, so this is
/// `memcpy` without the borrow-exclusion delegation -- a direct byte copy
/// over disjoint ranges, order-independent. The aliasing-storage move is
/// `memmove_within`.
///
/// DEVIATION from C `memmove` (C23-003): returns `CopyResult`; a bad size is
/// a typed error.
pub fn memmove(dst: &mut [byte], src: &[byte], n: usize) -> CopyResult {
    let cap: usize = slice_len(dst);
    let avail: usize = slice_len(src);
    if n > cap {
        return CopyResult::DestinationTooSmall(n, cap);
    }
    if n > avail {
        return CopyResult::DestinationTooSmall(n, avail);
    }
    let mut i: usize = 0;
    while i < n
        loop_invariant(i <= n)
    {
        dst[i] = src[i];
        i = i + 1;
    }
    return CopyResult::Copied(n);
}

/// C23-004 (Adapted). Overlap-safe `memmove` **within one buffer**: move
/// `len` bytes from `buf[src_start..]` to `buf[dst_start..]` as if the source
/// were snapshotted first. Delegates to `strings_bytes::move_within`
/// (`memmove`-style direction selection). Any out-of-range range is
/// `RangeOutOfBounds(start, len, available)` with `buf` unmodified.
pub fn memmove_within(buf: &mut [byte], dst_start: usize, src_start: usize,
                      len: usize) -> MoveResult {
    return move_within(buf, src_start, len, dst_start);
}

/// C23-005 (Adapted). Copy bytes of `src` into `dst` up to and including the
/// first byte equal to `stop`, or `n` bytes, whichever comes first.
///
/// `MemccpyReport`: `written` = number of bytes copied (includes the stop
/// byte when it was copied); `next_offset_present` is true **iff** the stop
/// byte was copied, and then `next_offset == written` -- the offset just past
/// the stop byte, an owned index, **never an interior pointer**. When `stop`
/// is not found within the bound, `written == min(n, src.len)` and
/// `next_offset_present == false`.
///
/// If `n` exceeds the destination capacity nothing is copied
/// (`written == 0`, `next_offset_present == false`): the safe façade does not
/// perform a partial write past a bound.
pub fn memccpy(dst: &mut [byte], src: &[byte], stop: byte, n: usize) -> MemccpyReport {
    let cap: usize = slice_len(dst);
    if n > cap {
        return MemccpyReport { written: 0, next_offset_present: false, next_offset: 0 };
    }
    let avail: usize = slice_len(src);
    let mut limit: usize = n;
    if limit > avail { limit = avail; }

    let mut i: usize = 0;
    let mut hit: bool = false;
    while i < limit
        loop_invariant(i <= limit)
        loop_invariant(limit <= cap)
    {
        let b: byte = src[i];
        dst[i] = b;
        i = i + 1;
        if b == stop { hit = true; break; }
    }

    if hit {
        return MemccpyReport { written: i, next_offset_present: true, next_offset: i };
    }
    return MemccpyReport { written: i, next_offset_present: false, next_offset: 0 };
}

/// C23-006 (Adapted). Index of the first byte in `haystack` equal to
/// `needle`, scanning only `[0, min(n, haystack.len()))` -- the safe façade
/// never reads past the slice bound even when the caller passes an `n`
/// larger than what is actually available (C `memchr` requires the caller
/// to guarantee `n` valid bytes; there is no such requirement here).
///
/// DEVIATION from C `memchr` (C23-006): returns `Option<usize>`, never a
/// dangling pointer.
pub fn memchr(haystack: &[byte], needle: byte, n: usize) -> Option<usize> {
    let avail: usize = slice_len(haystack);
    let mut limit: usize = n;
    if limit > avail { limit = avail; }
    return find(&haystack[0..limit], needle);
}

/// C23-006 / C23-020 / C23-021 (Adapted). Index of the first byte of the
/// `CStr` payload `s` equal to `c`. Per C23-021, searching for `c == 0`
/// finds the TERMINATING zero at payload offset `s.len()` (there is exactly
/// one, so first and last coincide); a nonzero `c` is compared against
/// payload bytes only and never inspects anything at or past the
/// terminator.
///
/// DEVIATION from C `strchr`: returns `Option<usize>`, an offset into the
/// payload -- never an interior pointer, so it cannot dangle past `s`'s
/// lifetime.
pub fn strchr(s: string, c: byte) -> Option<usize> {
    if c == 0 {
        return Option::Some(len(s));
    }
    return find(as_bytes(s), c);
}

/// C23-006 / C23-020 / C23-021 (Adapted). Index of the LAST byte of the
/// `CStr` payload `s` equal to `c`. `c == 0` finds the terminator at
/// `s.len()` (C23-021), identical to `strchr` since the terminator is
/// unique.
pub fn strrchr(s: string, c: byte) -> Option<usize> {
    if c == 0 {
        return Option::Some(len(s));
    }
    return rfind(as_bytes(s), c);
}

/// C `int c` -> `char` reduction for `strchr`/`strrchr` (C23-022): take the
/// low 8 bits. `c & 255` is signedness-agnostic -- the match is bit-pattern
/// equality on the resulting byte, never an arithmetic magnitude -- so a
/// target `char` being signed or unsigned does not change any result (see
/// docs/c23-char-conversion.md). Negative `c` wraps: `-1 & 255 == 255`.
fn c23_int_to_byte(c: i32) -> byte {
    return (c & 255) as byte;
}

/// C23-022 (Adapted). Exact-integer `strchr`: real C `strchr` takes an
/// `int c` and converts it to the target's `char` before comparing. The
/// observable rule is bit-pattern equality on the low 8 bits -- `c` and
/// `c + 256k` match the same byte, and target `char` signedness does not
/// change any match result (the comparison is on the byte value, not an
/// arithmetic magnitude; see docs/c23-char-conversion.md). This adapter
/// takes the wide `i32`, reduces it modulo 256, and forwards to `strchr`
/// (so `c == 0` still finds the terminator, C23-021).
pub fn strchr_int(s: string, c: i32) -> Option<usize> {
    let b: byte = c23_int_to_byte(c);
    return strchr(s, b);
}

/// C23-022 (Adapted). Exact-integer `strrchr`; same `int c` -> `char`
/// reduction as `strchr_int`.
pub fn strrchr_int(s: string, c: i32) -> Option<usize> {
    let b: byte = c23_int_to_byte(c);
    return strrchr(s, b);
}

/// C23-006 (Adapted). Index of the first byte of the `CStr` payload `s`
/// that is a member of the `CStr` payload `accept`. Delegates to
/// `strings_bytes::span_not_in`: the first index NOT in the maximal prefix
/// containing no `accept` member is exactly the first membership hit.
pub fn strpbrk(s: string, accept: string) -> Option<usize> {
    let sb: &[byte] = as_bytes(s);
    let n: usize = slice_len(sb);
    let idx: usize = span_not_in(sb, as_bytes(accept));
    if idx < n { return Option::Some(idx); }
    return Option::None;
}

/// C23-006 (Adapted). Index of the first occurrence of the `CStr` payload
/// `needle` within the `CStr` payload `haystack`; `Option::Some(0)` for an
/// empty needle (C23-023).
pub fn strstr(haystack: string, needle: string) -> Option<usize> {
    return find_slice(as_bytes(haystack), as_bytes(needle));
}

/// C23-007 (Adapted). Bounded unsigned-byte comparison of the first
/// `min(n, a.len(), b.len())` bytes of `a` and `b` -- never reads past
/// either slice's bound, so an `n` larger than what is actually available
/// on either side is simply clamped rather than being the caller's
/// obligation (as raw C `memcmp` requires).
///
/// DEVIATION from C `memcmp` (C23-007): returns `Ordering`, not an
/// arbitrary signed magnitude. `ordering_to_c_int` below recovers the
/// `-1 / 0 / 1` shape when a C-compatible integer is needed.
pub fn memcmp(a: &[byte], b: &[byte], n: usize) -> Ordering {
    let alen: usize = slice_len(a);
    let blen: usize = slice_len(b);
    let mut lim: usize = n;
    if lim > alen { lim = alen; }
    if lim > blen { lim = blen; }
    return compare(&a[0..lim], &b[0..lim]);
}

/// C23-007 (Adapted). Unsigned-byte comparison of the `CStr` payloads of
/// `a` and `b`. Payload bytes exclude the terminator (D-7), so this is
/// exactly `strings_bytes::compare` over the two payload views -- no
/// terminator byte ever enters the comparison, matching `strcmp`'s value
/// semantics without depending on a NUL sentinel to find the end.
pub fn strcmp(a: string, b: string) -> Ordering {
    return compare(as_bytes(a), as_bytes(b));
}

/// Length of the maximal prefix of `buf` (bounded by `limit`) that contains
/// no `0x00` byte -- the effective end of a possibly-non-terminated,
/// `n`-bounded C-string source (C23-027).
fn bound_to_nul(buf: &[byte], limit: usize) -> usize {
    let mut i: usize = 0;
    while i < limit
        loop_invariant(i <= limit)
    {
        if buf[i] == 0 { return i; }
        i = i + 1;
    }
    return limit;
}

/// C23-007 / C23-027 (Adapted). Compare `a` and `b` over at most `n` bytes
/// each, stopping at the first `0x00` within that bound or at `n`,
/// whichever comes first -- `a` / `b` need NOT contain a `0x00` within `n`
/// (a bounded initialized byte source, not necessarily a validated `CStr`).
/// Never reads past `n` or either slice's own bound.
pub fn strncmp(a: &[byte], b: &[byte], n: usize) -> Ordering {
    let acap: usize = slice_len(a);
    let bcap: usize = slice_len(b);
    let mut abound: usize = n;
    if abound > acap { abound = acap; }
    let mut bbound: usize = n;
    if bbound > bcap { bbound = bcap; }
    let ac: usize = bound_to_nul(a, abound);
    let bc: usize = bound_to_nul(b, bbound);
    return compare(&a[0..ac], &b[0..bc]);
}

/// SPEC Appendix B.1 (worked example): the canonical `Ordering` ->
/// C-integer adapter. `ensures` pins the C-compatible three-value range.
pub fn ordering_to_c_int(ordering: Ordering) -> i32
    ensures(result == -1 || result == 0 || result == 1)
{
    return match ordering {
        Ordering::Less => -1,
        Ordering::Equal => 0,
        Ordering::Greater => 1,
    };
}

/// First `0x00` in `buf`, or `slice_len(buf)` when none exists (same
/// recompute model as `strings_cstr::first_nul`, D-8: no cached state to go
/// stale).
fn cat_first_nul(buf: &[byte]) -> usize {
    let cap: usize = slice_len(buf);
    let mut i: usize = 0;
    while i < cap
        loop_invariant(i <= cap)
    {
        if buf[i] == 0 { return i; }
        i = i + 1;
    }
    return cap;
}

/// C23-008 (Adapted). Copy the whole `CStr` payload of `src`, plus one
/// terminator, into `dst`. `dst` must have room for the full payload —
/// unlike `strings_cstr::copy_into` (`strlcpy`), this never truncates.
///
/// DEVIATION from C `strcpy` (C23-008): destination capacity is the
/// explicit `dst: &mut [byte]` length, never inferred from a raw pointer;
/// insufficient capacity is `CopyResult::DestinationTooSmall(need, have)`
/// with `dst` left unmodified, never UB.
pub fn strcpy(dst: &mut [byte], src: string) -> CopyResult {
    let cap: usize = slice_len(dst);
    let plen: usize = string_len(src);
    let total: CheckedUsize = checked_add(plen, 1);
    let need: usize = match total {
        CheckedUsize::Ok(n) => { n },
        CheckedUsize::Overflow => { cap + 1 },
    };
    if need > cap {
        return CopyResult::DestinationTooSmall(need, cap);
    }
    let mut i: usize = 0;
    while i < plen
        loop_invariant(i <= plen)
        loop_invariant(plen + 1 <= cap)
    {
        dst[i] = string_char_at(src, i);
        i = i + 1;
    }
    dst[plen] = 0;
    return CopyResult::Copied(plen);
}

/// C23-009 (Adapted). Copy up to `n` bytes of `src` into `dst`, reproducing
/// `strncpy`'s exact zero-padding behavior byte-for-byte: bytes are copied
/// through the first `0x00` found within `[0, min(n, src.len()))` (or
/// through `min(n, src.len())` when none exists), then the REMAINDER of
/// `dst[0..n]` is filled with `0x00`. `src` need not be NUL-terminated or
/// even `n` bytes long (a bounded initialized byte source, C23-009 /
/// C23-027) -- when `src` is shorter than `n` with no `0x00` inside it, the
/// façade pads from where `src` ran out rather than reading past its bound
/// (real `strncpy` requires the caller to guarantee `n` valid `src` bytes
/// or an earlier terminator; that guarantee is undefined behavior here, so
/// the façade instead defines it).
///
/// DEVIATION from C `strncpy` (C23-009): when `src.len() >= n` and no
/// `0x00` occurs within the first `n` bytes, exactly `n` bytes are copied
/// with NO terminator appended (C23 does not guarantee one either) -- the
/// result is reported as `CopyResult::Copied(n)`, a byte-buffer outcome,
/// never a raw pointer. `n > dst.len()` is `DestinationTooSmall`, `dst`
/// unmodified.
pub fn strncpy(dst: &mut [byte], src: &[byte], n: usize) -> CopyResult {
    let cap: usize = slice_len(dst);
    if n > cap {
        return CopyResult::DestinationTooSmall(n, cap);
    }
    let avail: usize = slice_len(src);
    let mut lim: usize = n;
    if lim > avail { lim = avail; }
    let stop: usize = bound_to_nul(src, lim);

    let mut i: usize = 0;
    while i < stop
        loop_invariant(i <= stop)
        loop_invariant(stop <= n)
        loop_invariant(n <= cap)
    {
        dst[i] = src[i];
        i = i + 1;
    }
    while i < n
        loop_invariant(i <= n)
        loop_invariant(stop <= i)
        loop_invariant(n <= cap)
    {
        dst[i] = 0;
        i = i + 1;
    }
    return CopyResult::Copied(n);
}

/// C23-008 (Adapted). Append the whole `CStr` payload of `src`, plus one
/// terminator, after the first `0x00` of `dst` (the `CBuffer`'s existing
/// C-string state, recomputed by a bounded scan -- D-8). `dst` must have
/// room for the full appended payload; unlike `strings_cstr::append_into`
/// (`strlcat`), this never truncates. If `dst` holds no `0x00` at all,
/// there is no valid append point, so nothing is written.
///
/// DEVIATION from C `strcat` (C23-008): explicit `CBuffer` capacity, never
/// a raw pointer; insufficient capacity or a missing first-NUL is
/// `CopyResult::DestinationTooSmall(need, have)` with `dst` unmodified.
pub fn strcat(dst: &mut [byte], src: string) -> CopyResult {
    let cap: usize = slice_len(dst);
    let f: usize = cat_first_nul(dst);
    if f == cap {
        return CopyResult::DestinationTooSmall(cap + string_len(src) + 1, cap);
    }
    let plen: usize = string_len(src);
    let sum: CheckedUsize = checked_add(f, plen);
    let sum_ok: usize = match sum {
        CheckedUsize::Ok(k) => { k },
        CheckedUsize::Overflow => { cap },
    };
    let total: CheckedUsize = checked_add(sum_ok, 1);
    let need: usize = match total {
        CheckedUsize::Ok(k) => { k },
        CheckedUsize::Overflow => { cap + 1 },
    };
    if need > cap {
        return CopyResult::DestinationTooSmall(need, cap);
    }
    let mut i: usize = 0;
    while i < plen
        loop_invariant(i <= plen)
        loop_invariant(f + plen + 1 <= cap)
    {
        dst[f + i] = string_char_at(src, i);
        i = i + 1;
    }
    dst[f + plen] = 0;
    return CopyResult::Copied(plen);
}

/// C23-010 (Adapted). Append at most `n` bytes of `src` -- stopping at the
/// first `0x00` within `[0, min(n, src.len()))` when one exists -- after
/// the first `0x00` of `dst`, plus one terminator. `src` need not contain a
/// `0x00` within its first `n` bytes (a bounded initialized byte source,
/// C23-010). Checked destination capacity; if `dst` holds no `0x00` at all,
/// or the append does not fit, nothing is written.
pub fn strncat(dst: &mut [byte], src: &[byte], n: usize) -> CopyResult {
    let cap: usize = slice_len(dst);
    let f: usize = cat_first_nul(dst);
    if f == cap {
        return CopyResult::DestinationTooSmall(cap + n + 1, cap);
    }
    let avail: usize = slice_len(src);
    let mut lim: usize = n;
    if lim > avail { lim = avail; }
    let m: usize = bound_to_nul(src, lim);

    let sum: CheckedUsize = checked_add(f, m);
    let sum_ok: usize = match sum {
        CheckedUsize::Ok(k) => { k },
        CheckedUsize::Overflow => { cap },
    };
    let total: CheckedUsize = checked_add(sum_ok, 1);
    let need: usize = match total {
        CheckedUsize::Ok(k) => { k },
        CheckedUsize::Overflow => { cap + 1 },
    };
    if need > cap {
        return CopyResult::DestinationTooSmall(need, cap);
    }
    let mut i: usize = 0;
    while i < m
        loop_invariant(i <= m)
        loop_invariant(f + m + 1 <= cap)
    {
        dst[f + i] = src[i];
        i = i + 1;
    }
    dst[f + m] = 0;
    return CopyResult::Copied(m);
}

/// C23-011 (Adapted). A fresh owned `CString` copy of the `CStr` payload
/// `value`, plus one terminator -- the C23-recognizable name for
/// `strings_cstr::clone_owned` (SPEC Appendix A.5: `strdup` maps directly to
/// it). `len(value) + 1` is checked for `usize` overflow before any
/// allocation (`ConcatResult::LengthOverflow`, `value` unchanged); a genuine
/// allocation failure is not recoverable here -- the owned allocator fails
/// closed (`sv0_panic`, D-7 / SS-U02b/d) -- typed allocation failure ends at
/// the overflow check, same as every other owned-string constructor in this
/// library.
pub fn strdup(value: string) -> ConcatResult {
    return clone_owned(value);
}

/// C23-011 (Adapted). A fresh owned `CString` from a BOUNDED, possibly
/// non-terminated byte source: copies through the first `0x00` within
/// `[0, min(n, src.len()))` (or through the whole window when none exists --
/// `src` need not contain a `0x00` within its first `n` bytes), then appends
/// exactly one terminator. `stop + 1` is checked for `usize` overflow before
/// any allocation (`LengthOverflow`); the underlying owned allocator still
/// fails closed on a genuine allocation failure, matching `strdup` above and
/// every other owned-string constructor.
///
/// DEVIATION from C `strndup` (C23-011): never reads past `src`'s own
/// bound even when `src.len() < n` and no `0x00` is found -- real `strndup`
/// requires the caller to guarantee `n` valid bytes or an earlier
/// terminator (undefined otherwise); the safe façade instead defines it by
/// stopping at the slice's own length.
pub fn strndup(src: &[byte], n: usize) -> ConcatResult {
    let avail: usize = slice_len(src);
    let mut lim: usize = n;
    if lim > avail { lim = avail; }
    let stop: usize = bound_to_nul(src, lim);

    let total: CheckedUsize = checked_add(stop, 1);
    let over: bool = match total {
        CheckedUsize::Ok(_n) => { false },
        CheckedUsize::Overflow => { true },
    };
    if over {
        return ConcatResult::LengthOverflow;
    }
    return ConcatResult::Joined(string_concat(string_from_bytes(&src[0..stop]), "\0"));
}

/// C23-012 (Adapted). Length of the maximal prefix of the `CStr` payload
/// `s` all of whose bytes are members of the `CStr` payload `accept`.
/// Delegates directly to `strings_bytes::span_in` over the payload bytes
/// (SPEC ARCH-003: adapt the shared safe implementation, never duplicate
/// the algorithm).
pub fn strspn(s: string, accept: string) -> usize {
    return span_in(as_bytes(s), as_bytes(accept));
}

/// C23-012 (Adapted). Length of the maximal prefix of the `CStr` payload
/// `s` none of whose bytes are members of the `CStr` payload `reject`.
/// Delegates directly to `strings_bytes::span_not_in` over the payload
/// bytes.
pub fn strcspn(s: string, reject: string) -> usize {
    return span_not_in(as_bytes(s), as_bytes(reject));
}

/// C23-013 (Adapted). The C23-recognizable name for
/// `strings_tokenize::next` over a `CStr` payload and separator set:
/// `TokenStep::Emit(start, end, next_pos)` gives the next token as
/// `input[start..end]` (`input = as_bytes(s)`); call again with `pos =
/// next_pos` to resume. `TokenStep::Complete` means no more tokens.
///
/// DEVIATION from C `strtok` (C23-013): no hidden global/thread-local
/// continuation state (TOK-008) -- the caller threads `pos` explicitly, so
/// two independent tokenizations never interfere, unlike real `strtok`.
/// `s` and `separators` are immutable `CStr` payload VIEWS, never mutated
/// in place (real `strtok` overwrites each separator with `0x00`); the
/// separator set MAY differ on every call (TOK-009), and since a `CStr`
/// value is by construction the NUL-free payload up to its first `0x00`
/// (D-7), this operates only on bytes before that terminator -- trivially,
/// not by a runtime scan.
pub fn strtok(s: string, separators: string, pos: usize) -> TokenStep {
    return next(as_bytes(s), as_bytes(separators), pos);
}

/// C23-014 (Adapted). Set every byte of `dst` to `value` -- the
/// C23-recognizable name for `strings_bytes::fill` (SPEC Appendix A.5:
/// `memset` maps directly there). The write is bounded by `dst.len()` on
/// every path (slice bounds replace pointer/count UB).
///
/// This is the *plain* fill: it carries NO backend-enforced guarantee
/// against dead-store elimination. `memset_explicit` -- the scrubbing
/// variant C23 added for exactly that guarantee -- stays **Blocked**
/// (BYTE-010) and is deliberately **not exported from this module either**,
/// mirroring `strings_bytes::fill_explicit`'s own block; see
/// `docs/fill-explicit-blocked.md` for the recorded optimizer/VM-trace
/// evidence and the unblocking path (toolchain slice SS-U11). `memset` MUST
/// NOT be presented as a substitute for it.
pub fn memset(dst: &mut [byte], value: byte) -> () {
    fill(dst, value);
}

/// C23-015 (Adapted). The `CStr` payload's byte count -- the
/// C23-recognizable name for `strings_cstr::len` (SPEC Appendix A.5 maps
/// `strlen` directly there; thin re-export, no new logic).
///
/// **O(1), never a NUL scan.** `value` is an owned `string`, and EVERY
/// owned `string` in this library carries its length as a stored field
/// rather than requiring a terminator search (D-6/SS-U02b: `string_len`
/// lowers to `sv0_str_table[h].len` on the C backend -- a single struct
/// field read, `sv0c/runtime/sv0_runtime.h` -- and to SML's `size` on the
/// native VM, which is likewise O(1) on an SML `string`). This is exactly
/// C23-015's "accept `CStr`; SHALL NOT scan arbitrary `string` values or
/// unbounded memory": there is no code path here that walks bytes looking
/// for `0x00`, so a `CStr` payload with no trailing terminator at all
/// (e.g. `strings_cstr::borrow`'s output) still returns instantly and
/// correctly -- the correctness argument does not depend on one being
/// present.
pub fn strlen(value: string) -> usize {
    return len(value);
}

/// C23-016 (Host-dependent, capability STUB). Locale-sensitive collation
/// order of `a` and `b`. **Always `HostCapability::Unsupported` today** --
/// `strings_locale` (SPEC Section 17) stays fully unimplemented until R0.4
/// (BL-080), and there is no cross-backend host-locale service to delegate
/// to. `a` and `b` are never inspected or compared; there is deliberately
/// **no bytewise-comparison fallback** (C23-016 explicitly forbids
/// approximating collation with plain byte order -- that is a different,
/// well-defined operation `strcmp`/`strings_bytes::compare` already
/// provide, and confusing the two is exactly the failure mode this stub
/// exists to prevent). Once `strings_locale::compare` lands, this becomes a
/// thin delegating wrapper the same way every other adapter in this file
/// is.
pub fn strcoll(a: string, b: string) -> HostCapability {
    return HostCapability::Unsupported;
}

/// C23-016 / C23-029 (Host-dependent, capability STUB). Locale-sensitive
/// transform of `src` into `dst` for later bytewise comparison. **Always
/// `HostCapability::Unsupported` today**, for the same reason as `strcoll`
/// above; `dst` is never written to (no partial or synthesized transform is
/// ever observable -- so C23-029's "SHALL NOT expose destination bytes as
/// initialized transformed data when the standard makes their
/// representation indeterminate" holds trivially: nothing is ever written,
/// let alone exposed). Once `strings_locale::transform` lands (R0.4), this
/// becomes a thin delegating wrapper; the real form returns a report whose
/// payload is readable only when `required < n`, and callers who need the
/// length first use `strxfrm_size` below.
pub fn strxfrm(dst: &mut [byte], src: string) -> HostCapability {
    return HostCapability::Unsupported;
}

/// C23-024 (Host-dependent, capability STUB). The size-query form: how many
/// bytes `strxfrm(_, src)` would need. Takes **NO** destination -- C23-024
/// requires the zero-sized-destination query to be modeled "without
/// constructing an invalid mutable reference", and the cleanest way to
/// guarantee that is a signature with no `&mut [byte]` at all rather than a
/// `&mut []` a caller has to fabricate. **Always `HostCapability::Unsupported`
/// today**; once wired, this returns the required length and the two-call
/// pattern (`strxfrm_size` then an owned buffer then `strxfrm`) replaces C's
/// pass-`NULL`-with-size-0 idiom.
pub fn strxfrm_size(src: string) -> HostCapability {
    return HostCapability::Unsupported;
}

/// C23-017 (Host-dependent, capability STUB). An owned host error message
/// for `errnum`. **Always `HostCapability::Unsupported` today** -- sv0 has
/// no host-call primitive yet (`strings_unsafe_abi` is Future work,
/// BL-103/104), so there is no host error-message service to query.
/// Accepts every `i32` value uniformly (no range check, no branch on
/// `errnum` at all): C23-017 requires stable tests to compare *structured
/// error identity*, never universal message bytes, and the honest
/// R0.3 answer for EVERY error number is simply "not available yet" -- an
/// unknown error number is not itself an invalid argument (that
/// distinction matters once C23-030 lands, SS-151). Once an owned
/// host-error adapter is wired, this becomes a real implementation
/// returning message text, not this stub.
pub fn strerror(errnum: i32) -> HostCapability {
    return HostCapability::Unsupported;
}
