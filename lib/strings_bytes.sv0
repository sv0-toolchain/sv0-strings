/// strings_bytes -- safe operations over arbitrary byte slices.
///
/// SPEC.md Section 10 (safe byte API): compare, equal, copy, copy_prefix,
/// move_within, fill, fill_explicit, find, rfind, find_slice, span_in,
/// span_not_in, starts_with, ends_with. Semantic domain: bytes (embedded
/// zero and all values 0x00..0xFF allowed; no text decoding).
///
/// R0.1 progress:
///   SS-101  compare / equal                      -- IMPLEMENTED (this file)
///   SS-102  find / rfind / starts_with / ends_with -- IMPLEMENTED (this file)
///   SS-103  find_slice                           -- IMPLEMENTED (this file)
///   SS-104+ span_* / copy / ...                  -- unimplemented
///
/// Slice length is read with `slice_len(s)` (sv0doc type-system/rules.md
/// §2.2.1; the `sl.len()` method sugar is a later ergonomic slice).
module strings_bytes;

use strings_types::Ordering;
use strings_types::Option;

/// BYTE-001 (F0): lexicographic unsigned-byte comparison. Returns
/// `Ordering::Equal` iff both slices have the same length and every byte is
/// equal; otherwise the ordering is decided by the first differing byte
/// (unsigned value), and if one slice is a proper prefix of the other the
/// shorter slice is `Less`.
///
/// Not constant-time (BYTE-002 note): returns on the first difference.
pub fn compare(a: &[byte], b: &[byte]) -> Ordering {
    let alen: usize = slice_len(a);
    let blen: usize = slice_len(b);

    let mut n: usize = alen;
    if blen < alen { n = blen; }

    let mut i: usize = 0;
    while i < n
        loop_invariant(i <= n)
        loop_invariant(n <= alen)
        loop_invariant(n <= blen)
    {
        let av: byte = a[i];
        let bv: byte = b[i];
        if av < bv { return Ordering::Less; }
        if av > bv { return Ordering::Greater; }
        i = i + 1;
    }

    if alen < blen { return Ordering::Less; }
    if alen > blen { return Ordering::Greater; }
    return Ordering::Equal;
}

/// BYTE-002 (F0): extensionally equivalent to
/// `compare(a, b) == Ordering::Equal`. Not constant-time.
pub fn equal(a: &[byte], b: &[byte]) -> bool {
    return match compare(a, b) {
        Ordering::Equal => true,
        Ordering::Less => false,
        Ordering::Greater => false,
    };
}

/// BYTE-011 (F0): index of the first byte in `haystack` equal to `needle`,
/// or `Option::None`. An empty haystack yields `None`.
pub fn find(haystack: &[byte], needle: byte) -> Option<usize> {
    let n: usize = slice_len(haystack);
    let mut i: usize = 0;
    while i < n
        loop_invariant(i <= n)
    {
        if haystack[i] == needle { return Option::Some(i); }
        i = i + 1;
    }
    return Option::None;
}

/// BYTE-011 (F0): index of the last byte in `haystack` equal to `needle`,
/// or `Option::None`. An empty haystack yields `None`.
pub fn rfind(haystack: &[byte], needle: byte) -> Option<usize> {
    let n: usize = slice_len(haystack);
    let mut i: usize = n;
    while i > 0
        loop_invariant(i <= n)
    {
        i = i - 1;
        if haystack[i] == needle { return Option::Some(i); }
    }
    return Option::None;
}

/// BYTE-015 (R0.1): `true` iff `prefix` is a leading subsequence of `input`.
/// The empty sequence is a prefix of every sequence.
pub fn starts_with(input: &[byte], prefix: &[byte]) -> bool {
    let plen: usize = slice_len(prefix);
    let ilen: usize = slice_len(input);
    if plen > ilen { return false; }
    let mut i: usize = 0;
    while i < plen
        loop_invariant(i <= plen)
        loop_invariant(plen <= ilen)
    {
        if input[i] != prefix[i] { return false; }
        i = i + 1;
    }
    return true;
}

/// BYTE-015 (R0.1): `true` iff `suffix` is a trailing subsequence of `input`.
/// The empty sequence is a suffix of every sequence.
pub fn ends_with(input: &[byte], suffix: &[byte]) -> bool {
    let slen: usize = slice_len(suffix);
    let ilen: usize = slice_len(input);
    if slen > ilen { return false; }
    let off: usize = ilen - slen;
    let mut i: usize = 0;
    while i < slen
        loop_invariant(i <= slen)
        loop_invariant(off + slen <= ilen)
    {
        if input[off + i] != suffix[i] { return false; }
        i = i + 1;
    }
    return true;
}

/// True iff `needle` (`nlen` bytes) matches `hay` starting at byte offset
/// `off`. Assumes `off + nlen <= slice_len(hay)` (the caller enforces it).
fn slice_match_at(hay: &[byte], off: usize, needle: &[byte], nlen: usize) -> bool {
    let mut j: usize = 0;
    while j < nlen
        loop_invariant(j <= nlen)
    {
        if hay[off + j] != needle[j] { return false; }
        j = j + 1;
    }
    return true;
}

/// BYTE-012 (R0.1): index of the first occurrence of `needle` in `haystack`,
/// or `Option::None`. An empty needle returns `Option::Some(0)`; a needle
/// longer than the haystack returns `Option::None`.
///
/// Algorithm: naive left-to-right scan. It tries each start offset
/// `0 ..= haystack.len() - needle.len()` and compares byte-by-byte, stopping
/// at the first mismatch. Time is O(n * m) worst case (n = haystack length,
/// m = needle length) on adversarial repeated-prefix inputs, O(1) auxiliary
/// storage. This is the F0 reference implementation; an R1 replacement with a
/// linear-time algorithm is planned. See `docs/complexity.md` (PERF-002).
pub fn find_slice(haystack: &[byte], needle: &[byte]) -> Option<usize> {
    let hlen: usize = slice_len(haystack);
    let nlen: usize = slice_len(needle);
    if nlen == 0 { return Option::Some(0); }
    if nlen > hlen { return Option::None; }

    let last: usize = hlen - nlen;
    let mut s: usize = 0;
    while s <= last
        loop_invariant(s <= last + 1)
        loop_invariant(nlen <= hlen)
    {
        if slice_match_at(haystack, s, needle, nlen) { return Option::Some(s); }
        s = s + 1;
    }
    return Option::None;
}
