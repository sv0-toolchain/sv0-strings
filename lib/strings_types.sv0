/* strings_types -- shared public value types for the sv0-strings library.
 *
 * SPEC.md Section 8.2 (required type shapes). This slice (SS-005) lands the
 * value types that do not borrow: `Ordering`, the error enums, and the
 * report structs. `CStr` / `CString` / `CBuffer` and `TokenCursor` stay out
 * until byte slices and `Vec<byte>` execute end to end (SPEC UP-004,
 * UP-005; slice SS-U03).
 *
 * DEVIATION from SPEC Section 8.2 (recorded per GOV-004; see docs/BUGS.md
 * #1 and slice SS-U13): the error enums use TUPLE variants, not the named
 * struct variants the SPEC writes. The current native resolver registers
 * struct-variant field names in one global namespace, so any field name
 * reused across two struct variants -- `available` in BufferError, `offset`
 * across TextError/CStrError, `requested` across BufferError/LocaleError --
 * fails to resolve ("E0301: unknown type", span misattributed to an
 * unrelated file). Tuple variants have no such namespace and compile on
 * both backends. Positional meaning is documented per variant below; the
 * named-field form returns when SS-U13 lands.
 *
 * MODEL-008 (Ordering is the native compare result), MODEL-009 (recoverable
 * errors are data, not panics).
 */
module strings_types;

/* Library-local `Option` / `Result` (SS-U06 decision B). sv0c has no built-in
 * `Option`/`Result`; a user-declared generic enum with scalar payloads
 * monomorphizes end to end on both backends (verified 2026-09-02, sv0c
 * `e5fad7c` / sv0vm `4dc06a7`). Declaring them once here — the module every
 * other file already imports shared value types from — lets the rest of the
 * library and the C23/POSIX façades track the SPEC's literal
 * `Option<usize>` / `Result<T, E>` signatures.
 *
 * DEVIATION (recorded per GOV-004): the SPEC assumes `Option`/`Result` are
 * language-provided. sv0c predefining them is filed as an M5 prerequisite
 * (`task/sv0-toolchain-milestone-5-llvm-crypto.Rmd`, before the LLVM backend
 * / crypto API slices); until then the library owns the declarations. Any
 * instantiation whose payload is a struct/slice (not a scalar) may hit the
 * deferred lowering-side monomorphization gap (T0-2d,
 * `sv0doc/compiler/bootstrap-generics-policy.md`) — such a case falls back to
 * a concrete carrier + its own deviation note, never blocks a slice.
 */
pub enum Option<T> {
    Some(T),
    None,
}

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

/* Total order result of a comparison (SPEC MODEL-008). Native callers match
 * on this; they never depend on an arbitrary signed magnitude. A
 * C-compatible `-1 / 0 / 1` adapter lives in `strings_c23`.
 */
pub enum Ordering {
    Less,
    Equal,
    Greater,
}

/* Capacity, range, overlap, overflow, and allocation failures for byte and
 * C-string operations (SPEC MODEL-009, Section 8.2). Every failable byte
 * API returns one of these in its `Result::Err`.
 *
 *   DestinationTooSmall(needed, available)
 *   RangeOutOfBounds(start, len, available)
 *   OverlapForbidden
 *   LengthOverflow
 *   AllocationFailed(requested)
 */
pub enum BufferError {
    DestinationTooSmall(usize, usize),
    RangeOutOfBounds(usize, usize, usize),
    OverlapForbidden,
    LengthOverflow,
    AllocationFailed(usize),
}

/* UTF-8 validity failures (SPEC Section 8.2, TEXT-012/013).
 *
 *   InvalidUtf8(valid_up_to)      -- byte length of the longest well-formed prefix
 *   NotScalarBoundary(offset)     -- a byte offset that is not a scalar start
 */
pub enum TextError {
    InvalidUtf8(usize),
    NotScalarBoundary(usize),
}

/* C-string invariant failures (SPEC Section 8.2, CSTR-001/002/005/006).
 *
 *   MissingTerminator
 *   InteriorNul(offset)
 */
pub enum CStrError {
    MissingTerminator,
    InteriorNul(usize),
}

/* Locale service failures (SPEC Section 8.2, HOST-004). An unsupported
 * locale is reported, never silently downgraded to ASCII or bytewise.
 *
 *   InvalidLocale
 *   UnsupportedLocale(locale_id)   -- SPEC spells `{ requested: string }`;
 *                                    `string` is blocked by UP-001 (SS-U02*),
 *                                    so a caller-supplied id token stands in.
 *   AllocationFailed
 */
pub enum LocaleError {
    InvalidLocale,
    UnsupportedLocale(usize),
    AllocationFailed,
}

/* Result of a bounded / truncating copy (SPEC Section 8.2, CSTR-018).
 * `written` = source payload bytes copied (excludes any NUL);
 * `required` = the full destination payload length attempted;
 * `truncated` is derived from the operation's bound, not from `written`.
 */
pub struct CopyReport {
    pub written: usize,
    pub required: usize,
    pub truncated: bool,
}

/* Result of `strings_bytes::copy` (SPEC Section 10, BYTE-003 / BYTE-005).
 *
 * DEVIATION (recorded per GOV-004; f0-deviations.md D-4 / slice SS-U06): the
 * SPEC signature is `copy(...) -> Result<usize, BufferError>`. A structured
 * `BufferError` in a generic `Result` Err slot does not lower on the C
 * backend (deferred T0-2d monomorphization). `copy` therefore returns this
 * concrete carrier with the error fields inline; the safe semantics are
 * unchanged. Returns to `Result<usize, BufferError>` when sv0c predefines
 * `Result` + lands T0-2d (M5 prerequisite).
 *
 *   Copied(n)                     -- Ok: n bytes written, n == src.len()
 *   DestinationTooSmall(need, have) -- Err: dst was left unmodified
 */
pub enum CopyResult {
    Copied(usize),
    DestinationTooSmall(usize, usize),
}

/* Result of `strings_text::validate_utf8` (SPEC Section 11, TEXT-012 /
 * TEXT-013; slice SS-121). Same GOV-004 / D-4 deviation as `CopyResult` /
 * `MoveResult`: the SPEC signature is `-> Result<(), TextError>`; a
 * structured `TextError` in a generic `Result` Err slot does not lower on
 * the C backend (deferred T0-2d monomorphization), so a concrete carrier is
 * used. `validate_utf8` only ever reports an invalid encoding (never
 * `NotScalarBoundary`, which belongs to `slice_bytes`), so two variants
 * suffice.
 *
 *   Valid                          -- Ok: the whole slice is RFC 3629 UTF-8
 *   Invalid(valid_up_to)           -- Err: byte length of the longest
 *                                    complete, well-formed UTF-8 prefix; a
 *                                    truncated final sequence reports the
 *                                    offset at which that sequence begins
 *                                    (TEXT-013)
 */
pub enum Utf8Check {
    Valid,
    Invalid(usize),
}

/* Result of `strings_text::concat` (SPEC Section 11, TEXT-005 / TEXT-006;
 * slice SS-123). Same GOV-004 / D-4 deviation as `CopyResult` / `MoveResult`
 * / `Utf8Check`: the SPEC signature is `-> Result<string, BufferError>`; a
 * structured `BufferError` in a generic `Result` Err slot does not lower on
 * the C backend.
 *
 *   Joined(s)                      -- Ok: a newly owned `string` equal to
 *                                    `a` followed by `b`
 *   LengthOverflow                 -- Err: `len_bytes(a) + len_bytes(b)`
 *                                    does not fit in `usize`; nothing was
 *                                    allocated and both inputs are unchanged
 *
 * `BufferError::AllocationFailed` has no recoverable form here: the owned
 * allocator fails closed with `sv0_panic` (SS-U02b/d, OQ-003), so a real
 * allocation failure aborts rather than returning; the inputs are still
 * never mutated.
 */
pub enum ConcatResult {
    Joined(string),
    LengthOverflow,
}

/* Result of `strings_text::slice_bytes` (SPEC Section 11, TEXT-010 /
 * TEXT-011; slice SS-124). Same GOV-004 / D-4 deviation as the carriers
 * above: the SPEC signature is `-> Result<string, TextError>`; a structured
 * `TextError` in a generic `Result` Err slot does not lower on the C
 * backend.
 *
 *   Slice(s)                       -- Ok: bytes `[start, end)` as a new
 *                                    owned `string`, still valid UTF-8
 *   NotScalarBoundary(off)         -- Err: `off` (the first offending of
 *                                    `start` / `end`) is past
 *                                    `len_bytes(value)`, breaks
 *                                    `start <= end`, or is not a UTF-8
 *                                    scalar boundary. `value` was not read
 *                                    outside its bounds and no malformed
 *                                    `string` was built. `TextError`'s
 *                                    `InvalidUtf8` variant is unreachable
 *                                    here (the input is already valid UTF-8
 *                                    by the `Text` domain precondition).
 */
pub enum SliceResult {
    Slice(string),
    NotScalarBoundary(usize),
}

/* Result of `strings_text::from_utf8` (SPEC Section 11, TEXT-014; slice
 * SS-125). Same GOV-004 / D-4 deviation as the carriers above: the SPEC
 * signature is `-> Result<string, TextError>`.
 *
 *   Text(s)                        -- Ok: `bytes` copied into a new owned
 *                                    `string` (embedded U+0000 preserved)
 *   Invalid(valid_up_to)           -- Err: `bytes` is not RFC 3629 UTF-8;
 *                                    `valid_up_to` is the byte length of the
 *                                    longest well-formed prefix (as
 *                                    `validate_utf8` / TEXT-013). No string
 *                                    is allocated.
 */
pub enum FromUtf8Result {
    Text(string),
    Invalid(usize),
}

/* Results of the `strings_cstr` constructors (SPEC Section 13, CSTR-001/002
 * for `CStrResult`; CSTR-005/006 for `CStringResult`; slice SS-126). Same
 * GOV-004 / D-4 deviation as the carriers above -- the SPEC signatures are
 * `Result<CStr, CStrError>` / `Result<CString, CStrError>`.
 *
 * DEVIATION D-7 (recorded per GOV-004; see docs/f0-deviations.md): `CStr`
 * and `CString` have no distinct sv0 type. An enum variant carrying a
 * struct payload does not lower on the C backend (the R0.3 struct-in-enum
 * limit / KC-006 zone; a wrapper-struct prototype self-host-compiled to
 * `vec: index out of bounds`). So both are represented as an owned
 * `string`: a `CStr` value is the validated NUL-free payload; a `CString`
 * value is `<payload><one 0x00>`. The `borrows(...)` relations become
 * advisory -- the source bytes are copied at construction, so no dangling
 * view is possible and the "no rescan after construction" invariants
 * (CSTR-003 / CSTR-017) hold because the payload length travels with the
 * value.
 *
 *   CStrResult:
 *     View(payload)        -- Ok: NUL-free payload bytes
 *     NoTerminator         -- Err (CStrError::MissingTerminator)
 *     InteriorAt(offset)   -- Err (CStrError::InteriorNul), first interior 0
 *
 *   CStringResult:
 *     Owned(bytes_with_nul) -- Ok: <payload><0x00>
 *     InteriorAt(offset)    -- Err (CStrError::InteriorNul)
 */
pub enum CStrResult {
    View(string),
    NoTerminator,
    InteriorAt(usize),
}

pub enum CStringResult {
    Owned(string),
    InteriorAt(usize),
}

/* Result of `strings_cstr::append_into` (SPEC Section 13, CSTR-012; slice
 * SS-128). The SPEC signature is `-> Result<CopyReport, BufferError>`; a
 * struct (`CopyReport`) payload does not lower inside an enum variant on the
 * C backend (same limit as D-7), so the report fields are inlined as a
 * scalar tuple variant.
 *
 *   Reported(written, required, truncated)
 *                      -- Ok: `written` = source payload bytes appended
 *                         (CSTR-018), `required` = the full destination
 *                         payload length the operation attempted,
 *                         `truncated` = `required >= capacity`
 *   LengthOverflow     -- Err: the checked `first_nul + src.len()` (or
 *                         `capacity + src.len()` when no first NUL exists)
 *                         did not fit in `usize`; nothing was written
 */
pub enum AppendResult {
    Reported(usize, usize, bool),
    LengthOverflow,
}

/* Explicit tokenization state (SPEC Section 14, TOK-001; slice SS-129).
 * Caller-owned; there is no module-global continuation state. `pos` is the
 * next byte offset `strings_tokenize::next` will scan from; `complete` is
 * set by the caller once `next` reports `TokenStep::Complete`.
 */
pub struct TokenCursor {
    pub pos: usize,
    pub complete: bool,
}

/* Result of `strings_tokenize::next` (SPEC Section 14; slice SS-129).
 *
 * DEVIATION D-9 (recorded per GOV-004; see docs/f0-deviations.md): the SPEC
 * shape is `next(..., cursor: &mut TokenCursor) -> Option<Token>` where
 * `Token borrows(input) { bytes: &[byte], start, end }`. sv0 has no working
 * `&mut <struct>` parameter, and neither a `&[byte]` struct field nor a
 * struct payload inside an enum variant lowers on the C backend. So `next`
 * threads the cursor position by value and returns this scalar carrier; a
 * token is the offset pair `[start, end)` into `input` (the caller forms
 * `&input[start..end]`), and `next_pos` is the position to resume from.
 *
 *   Emit(start, end, next_pos)  -- a non-empty token `input[start..end]`;
 *                                  call `next` again with `pos = next_pos`
 *   Complete                    -- no more tokens; the cursor is done
 */
pub enum TokenStep {
    Emit(usize, usize, usize),
    Complete,
}

/* Result of `strings_bytes::move_within` (SPEC Section 10, BYTE-007 /
 * BYTE-008). Same GOV-004 / D-4 deviation as `CopyResult`: the SPEC
 * signature is `-> Result<(), BufferError>`; a structured `BufferError` in a
 * generic `Result` Err slot does not lower on the C backend, so a concrete
 * carrier is used.
 *
 *   Moved                          -- Ok: the move completed
 *   RangeOutOfBounds(start, len, available)
 *                                  -- Err: a src or dst range left `buf`;
 *                                     `buf` was not modified
 */
pub enum MoveResult {
    Moved,
    RangeOutOfBounds(usize, usize, usize),
}

/* Runtime-accelerator selection harness (SPEC UP-011 / BACKEND-003, §4.8
 * Tier 2; slice SS-110). R0.1 is Tier-1 pure-only: `accel_available` is
 * always `false` and `accel_version` is 0, so every accelerable operation
 * selects its pure sv0 path with identical semantics -- UP-011: the absence
 * of an accelerator selects pure, it never changes results. A future Tier-2
 * build sets these from a versioned capability probe; the test harness then
 * runs the same fixture/property suite with acceleration off and on to prove
 * equivalence (BACKEND-003 / AC-020).
 *
 * DEVIATION (GOV-004): SPEC ARCH-001 fixes the 11 flat `strings_*` module
 * names, so this shared capability shape lives in `strings_types` rather
 * than a dedicated module -- same treatment as `Option` / `Result`.
 */
pub fn ACCEL_CAP_BYTE_SEARCH() -> i32 { return 1; }
pub fn ACCEL_CAP_CASE_FOLD() -> i32 { return 2; }
pub fn ACCEL_CAP_SUBSTRING() -> i32 { return 3; }

/// Version of the enabled accelerator set. 0 == pure-only (no accelerators).
pub fn accel_version() -> i32 {
    return 0;
}

/// Is a Tier-2 accelerator for capability `cap` enabled? Always `false` at
/// R0.1 (pure-only). A Tier-2 build derives this from a versioned probe; the
/// harness forces it `false` to run the pure suite.
pub fn accel_available(cap: i32) -> bool {
    return false;
}

/* Result of a `memccpy`-style stop-byte copy (SPEC Section 8.2, C23-005,
 * MODEL-017). `next_offset_present` + `next_offset` stand in for
 * `Option<usize>` until generic result payloads across modules are proven
 * (SPEC UP-020, OQ-010; slice SS-U06): `next_offset_present` is true iff the
 * stop byte was copied, and then `next_offset == written`.
 */
pub struct MemccpyReport {
    pub written: usize,
    pub next_offset_present: bool,
    pub next_offset: usize,
}

/* Shared "Host-dependent" capability outcome for `strcoll` / `strxfrm` /
 * `strerror` (SPEC C23-016/017, slice SS-150). No cross-backend host-locale
 * or host-error service is wired at R0.3: `strings_locale` (SPEC Section
 * 17) stays fully unimplemented until R0.4 (BL-080), and the raw host-call
 * primitive `strings_locale`/`strerror` would eventually need lives in
 * `strings_unsafe_abi`, itself Future work (BL-103/104). So every C23
 * host-dependent adapter fails closed to `Unsupported` for now -- NEVER a
 * silent bytewise/ASCII collation substitute (C23-016 explicitly forbids
 * this) and NEVER an approximated or synthesized message/identity
 * (C23-017). This is a capability STUB, not a `Blocked` non-export
 * (BYTE-010's treatment): the C23-recognizable functions exist and are
 * callable, they are simply honest that the underlying host capability
 * does not exist yet.
 */
pub enum HostCapability {
    Unsupported,
}
