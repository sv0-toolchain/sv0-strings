/// strings_text -- UTF-8-preserving operations over owned `string` and
/// borrowed text views.
///
/// SPEC.md Section 11 (safe UTF-8 text API): len_bytes, is_empty, equal,
/// compare_bytes, concat, find_byte, find, rfind, starts_with, ends_with,
/// slice_bytes, validate_utf8, from_utf8, as_bytes. Semantic domain: valid
/// UTF-8 (RFC 3629); byte offsets are not Unicode scalar indices.
///
/// R0.2 progress:
///   SS-121  validate_utf8 (RFC 3629 validator, precise valid_up_to) --
///           IMPLEMENTED (this file). Returns the `strings_types::Utf8Check`
///           concrete carrier (D-4 deviation; SPEC writes
///           `Result<(), TextError>`).
///   SS-122  len_bytes / is_empty / equal / compare_bytes --
///           IMPLEMENTED (this file). Whole-string semantics over the
///           length-bearing owned `string` (SS-U02b/c); no `strlen` /
///           `strcmp` (TEXT-016).
///   SS-123  concat -- IMPLEMENTED (this file). One `string_concat`
///           allocation after a checked `len_bytes(a) + len_bytes(b)`;
///           `ConcatResult` carrier (SPEC `Result<string, BufferError>`).
///   SS-124  find_byte / find / rfind / starts_with / ends_with /
///           slice_bytes -- IMPLEMENTED (this file). Byte-level UTF-8
///           search + scalar-boundary-checked slicing (`SliceResult`
///           carrier for SPEC `Result<string, TextError>`).
///
/// The remaining Section 11 surface (from_utf8 / as_bytes) is unimplemented
/// -- R0.2 slice SS-125.
///
/// DEVIATION (recorded per GOV-004; f0-deviations.md D-6): the SPEC signatures
/// take `&string` (and `as_bytes` returns `&[byte] borrows(value)`). sv0 has
/// no surface `&string` reference type -- `string` is already an indirection
/// handle (`sv0_str` id; SS-U02b) -- so these functions take `string` by
/// value. Ownership is unchanged: the callee neither mutates nor frees the
/// handle. `&[byte]` borrows (SS-U03) are unaffected and keep the reference
/// form.
///
/// Slice length is read with `slice_len(s)` (sv0doc type-system/rules.md
/// §2.2.1; the `sl.len()` method sugar is a later ergonomic slice).
module strings_text;

use strings_types::Ordering;
use strings_types::Option;
use strings_types::Utf8Check;
use strings_types::ConcatResult;
use strings_types::SliceResult;
use strings_checked::checked_add;
use strings_checked::CheckedUsize;

/// TEXT-001 (F0): number of UTF-8 code units. Embedded U+0000 counts as one
/// byte. Reads the length field of the owned `string` (SS-U02b) -- never
/// `strlen`.
pub fn len_bytes(value: string) -> usize {
    let n: usize = string_len(value);
    return n;
}

/// TEXT-002 (F0): `is_empty(s)` is exactly `len_bytes(s) == 0`.
pub fn is_empty(value: string) -> bool {
    return string_len(value) == 0;
}

/// TEXT-003 (F0): compare the complete UTF-8 byte sequences, including every
/// byte after an embedded U+0000. `string_eq` is length + `memcmp` on both
/// backends (SS-U02b/c) -- never `strcmp`.
pub fn equal(a: string, b: string) -> bool {
    return string_eq(a, b);
}

/// TEXT-004 (R0.2): deterministic unsigned-byte lexicographic ordering, no
/// ambient locale. `Equal` iff both lengths and every byte match; otherwise
/// the first differing byte (as an unsigned 0..255 value from
/// `string_char_at`) decides, and a proper prefix is `Less` than the longer
/// string. Not constant-time.
pub fn compare_bytes(a: string, b: string) -> Ordering {
    let alen: usize = string_len(a);
    let blen: usize = string_len(b);

    let mut n: usize = alen;
    if blen < alen { n = blen; }

    let mut i: usize = 0;
    while i < n
        loop_invariant(i <= n)
        loop_invariant(n <= alen)
        loop_invariant(n <= blen)
    {
        let av: usize = string_char_at(a, i);
        let bv: usize = string_char_at(b, i);
        if av < bv { return Ordering::Less; }
        if av > bv { return Ordering::Greater; }
        i = i + 1;
    }

    if alen < blen { return Ordering::Less; }
    if alen > blen { return Ordering::Greater; }
    return Ordering::Equal;
}

/// TEXT-005 (R0.2): a newly owned `string` equal to `a` followed by `b`.
/// TEXT-006 (R0.2): `len_bytes(a) + len_bytes(b)` is checked for `usize`
/// overflow BEFORE any allocation. On `LengthOverflow` nothing is allocated
/// and both inputs are left unchanged (they are immutable handles; the
/// checked add runs first, so `string_concat` is never reached). A genuine
/// allocation failure is not recoverable here -- the owned allocator fails
/// closed with `sv0_panic` (SS-U02b/d) -- but it too leaves the inputs
/// unchanged.
///
/// One allocation: the single `string_concat` call. Embedded U+0000 in
/// either input is preserved (length-based copy, SS-U02b/c).
pub fn concat(a: string, b: string) -> ConcatResult {
    let total: CheckedUsize = checked_add(len_bytes(a), len_bytes(b));
    /* `match` yields a plain bool here; the enum values are built in the
       `return` statements below -- a `return match { ... Enum::V(..) }` form
       mistypes its result temp on the C emitter (toolchain bug, mathlib #12). */
    let overflowed: bool = match total {
        CheckedUsize::Overflow => { true },
        CheckedUsize::Ok(_n) => { false },
    };
    if overflowed {
        return ConcatResult::LengthOverflow;
    }
    return ConcatResult::Joined(string_concat(a, b));
}

/// True iff the `nlen` bytes of `needle` occur in `value` starting at byte
/// offset `off`. The caller guarantees `off + nlen <= len_bytes(value)`.
fn text_match_at(value: string, off: usize, needle: string, nlen: usize) -> bool {
    let mut j: usize = 0;
    while j < nlen
        loop_invariant(j <= nlen)
    {
        if string_char_at(value, off + j) != string_char_at(needle, j) { return false; }
        j = j + 1;
    }
    return true;
}

/// TEXT-007 (R0.2): byte index of the first byte of `value` equal to
/// `needle`, or `Option::None`; an empty `value` yields `None`. This
/// searches raw UTF-8 bytes -- when `needle` is a UTF-8 continuation byte
/// (`0x80..0xBF`) the returned index MAY fall inside a multibyte scalar and
/// is NOT guaranteed to be a scalar boundary.
pub fn find_byte(value: string, needle: byte) -> Option<usize> {
    let n: usize = len_bytes(value);
    let mut i: usize = 0;
    while i < n
        loop_invariant(i <= n)
    {
        if string_char_at(value, i) == needle { return Option::Some(i); }
        i = i + 1;
    }
    return Option::None;
}

/// TEXT-008 / TEXT-009 (R0.2): byte offset of the first occurrence of
/// `needle` in `value`, or `Option::None`. An empty needle returns
/// `Option::Some(0)`; a needle longer than `value` returns `Option::None`.
/// For a valid-UTF-8 needle the offset is a UTF-8 scalar boundary.
///
/// Naive left-to-right scan, O(n*m) worst case (see `docs/complexity.md`,
/// PERF-002); an R1 linear-time replacement is planned.
pub fn find(value: string, needle: string) -> Option<usize> {
    let n: usize = len_bytes(value);
    let m: usize = len_bytes(needle);
    if m == 0 { return Option::Some(0); }
    if m > n { return Option::None; }

    let last: usize = n - m;
    let mut i: usize = 0;
    while i <= last
        loop_invariant(i <= last + 1)
        loop_invariant(m <= n)
    {
        if text_match_at(value, i, needle, m) { return Option::Some(i); }
        i = i + 1;
    }
    return Option::None;
}

/// TEXT-008 / TEXT-009 (R0.2): byte offset of the LAST occurrence of
/// `needle` in `value`, or `Option::None`. An empty needle returns
/// `Option::Some(len_bytes(value))`; a needle longer than `value` returns
/// `Option::None`.
pub fn rfind(value: string, needle: string) -> Option<usize> {
    let n: usize = len_bytes(value);
    let m: usize = len_bytes(needle);
    if m == 0 { return Option::Some(n); }
    if m > n { return Option::None; }

    let mut i: usize = n - m + 1;
    while i > 0
        loop_invariant(i <= n - m + 1)
        loop_invariant(m <= n)
    {
        i = i - 1;
        if text_match_at(value, i, needle, m) { return Option::Some(i); }
    }
    return Option::None;
}

/// TEXT-009 (R0.2): `true` iff `prefix` is a leading byte sequence of
/// `value`. The empty string is a prefix of every string.
pub fn starts_with(value: string, prefix: string) -> bool {
    let vlen: usize = len_bytes(value);
    let plen: usize = len_bytes(prefix);
    if plen > vlen { return false; }
    return text_match_at(value, 0, prefix, plen);
}

/// TEXT-009 (R0.2): `true` iff `suffix` is a trailing byte sequence of
/// `value`. The empty string is a suffix of every string.
pub fn ends_with(value: string, suffix: string) -> bool {
    let vlen: usize = len_bytes(value);
    let slen: usize = len_bytes(suffix);
    if slen > vlen { return false; }
    return text_match_at(value, vlen - slen, suffix, slen);
}

/// True iff byte offset `i` (`i <= n`) is a UTF-8 scalar boundary of
/// `value`, assumed valid UTF-8 (the `Text` domain precondition): the
/// start, the end, or a byte that is not a continuation byte
/// (`0x80..0xBF`).
fn text_is_boundary(value: string, i: usize, n: usize) -> bool {
    if i == 0 { return true; }
    if i == n { return true; }
    let b: byte = string_char_at(value, i);
    if b < 128 { return true; }
    if b > 191 { return true; }
    return false;
}

/// TEXT-010 / TEXT-011 (R0.2): the bytes `[start, end)` of `value` as a new
/// owned `string`. Requires `start <= end <= len_bytes(value)` and both
/// offsets to be UTF-8 scalar boundaries. Any violation returns
/// `SliceResult::NotScalarBoundary(off)` for the first offending offset --
/// checked in the order start-past-end, end-past-end, `start > end`, start
/// not on a boundary, end not on a boundary -- and never reads outside
/// `value` or constructs a malformed `string`. On success the result equals
/// bytes `[start, end)` and is valid UTF-8.
pub fn slice_bytes(value: string, start: usize, end: usize) -> SliceResult {
    let n: usize = len_bytes(value);
    if start > n { return SliceResult::NotScalarBoundary(start); }
    if end > n { return SliceResult::NotScalarBoundary(end); }
    if start > end { return SliceResult::NotScalarBoundary(start); }
    if text_is_boundary(value, start, n) != true { return SliceResult::NotScalarBoundary(start); }
    if text_is_boundary(value, end, n) != true { return SliceResult::NotScalarBoundary(end); }
    return SliceResult::Slice(string_substr(value, start, end - start));
}

/// TEXT-012 (R0.2): accept exactly the RFC 3629 language -- shortest form
/// only, no surrogate values (U+D800..U+DFFF), nothing above U+10FFFF.
///
/// TEXT-013 (R0.2): on rejection, `Utf8Check::Invalid(valid_up_to)` where
/// `valid_up_to` is the byte length of the longest prefix that is complete,
/// well-formed UTF-8. A truncated final sequence (a valid lead byte with
/// too few continuation bytes left, or a continuation byte outside its
/// permitted range) reports the offset at which that sequence *begins*.
///
/// Classification covered: 1/2/3/4-byte forms; stray continuation byte;
/// overlong 2-byte (`0xC0`/`0xC1`), overlong 3-byte (`0xE0` + `0x80..0x9F`),
/// overlong 4-byte (`0xF0` + `0x80..0x8F`); surrogate (`0xED` +
/// `0xA0..0xBF`); above U+10FFFF (`0xF4` + `0x90..0xBF`, and every lead
/// `0xF5..0xFF`); truncation at end of slice.
///
/// Reads the slice strictly left to right and never past `slice_len(bytes)`.
pub fn validate_utf8(bytes: &[byte]) -> Utf8Check {
    let n: usize = slice_len(bytes);
    let mut i: usize = 0;

    while i < n
        loop_invariant(i <= n)
    {
        let b0: byte = bytes[i];

        if b0 <= 127 {
            /* 1-byte: U+0000..U+007F (embedded NUL included). */
            i = i + 1;
        } else {
            if b0 <= 193 {
                /* 0x80..0xBF stray continuation, or 0xC0/0xC1 overlong
                 * 2-byte lead: the sequence is invalid where it starts. */
                return Utf8Check::Invalid(i);
            }
            if b0 <= 223 {
                /* 2-byte lead 0xC2..0xDF -> U+0080..U+07FF. */
                if i + 1 >= n { return Utf8Check::Invalid(i); }
                let c1: byte = bytes[i + 1];
                if c1 < 128 { return Utf8Check::Invalid(i); }
                if c1 > 191 { return Utf8Check::Invalid(i); }
                i = i + 2;
            } else {
                if b0 <= 239 {
                    /* 3-byte lead 0xE0..0xEF -> U+0800..U+FFFF. */
                    if i + 2 >= n { return Utf8Check::Invalid(i); }
                    let d1: byte = bytes[i + 1];
                    let d2: byte = bytes[i + 2];
                    let mut lo: byte = 128;
                    let mut hi: byte = 191;
                    if b0 == 224 { lo = 160; }  /* 0xE0: reject overlong  */
                    if b0 == 237 { hi = 159; }  /* 0xED: reject surrogate */
                    if d1 < lo { return Utf8Check::Invalid(i); }
                    if d1 > hi { return Utf8Check::Invalid(i); }
                    if d2 < 128 { return Utf8Check::Invalid(i); }
                    if d2 > 191 { return Utf8Check::Invalid(i); }
                    i = i + 3;
                } else {
                    if b0 > 244 {
                        /* 0xF5..0xFF: every scalar would exceed U+10FFFF. */
                        return Utf8Check::Invalid(i);
                    }
                    /* 4-byte lead 0xF0..0xF4 -> U+10000..U+10FFFF. */
                    if i + 3 >= n { return Utf8Check::Invalid(i); }
                    let e1: byte = bytes[i + 1];
                    let e2: byte = bytes[i + 2];
                    let e3: byte = bytes[i + 3];
                    let mut lo4: byte = 128;
                    let mut hi4: byte = 191;
                    if b0 == 240 { lo4 = 144; }  /* 0xF0: reject overlong      */
                    if b0 == 244 { hi4 = 143; }  /* 0xF4: reject > U+10FFFF    */
                    if e1 < lo4 { return Utf8Check::Invalid(i); }
                    if e1 > hi4 { return Utf8Check::Invalid(i); }
                    if e2 < 128 { return Utf8Check::Invalid(i); }
                    if e2 > 191 { return Utf8Check::Invalid(i); }
                    if e3 < 128 { return Utf8Check::Invalid(i); }
                    if e3 > 191 { return Utf8Check::Invalid(i); }
                    i = i + 4;
                }
            }
        }
    }

    return Utf8Check::Valid;
}
